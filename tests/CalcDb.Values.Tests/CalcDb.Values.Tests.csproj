<Project Sdk="Microsoft.NET.Sdk">
  <!-- W-02 acceptance: T-INT-02/25/33..41 against the platform's own Automation services on Windows x64, the
       Temporary/ stand-ins against real oleaut32 (docs/work/oleaut32-usage.md rule 5), and the scalar service
       (T-EXPR-09..22) against retained ACE answers. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>$(NoWarn);CA1707;CA2201;CA5392</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\CalcDb.Foundation\CalcDb.Foundation.csproj" />
    <ProjectReference Include="..\..\src\CalcDb.Values\CalcDb.Values.csproj" />
    <ProjectReference Include="..\..\src\CalcDb.Evidence\CalcDb.Evidence.csproj" />
    <!-- The one verdict comparer of captured values (ValueComparer) for kernel results against ACE's answers. -->
    <ProjectReference Include="..\..\src\CalcDb.Corpus\CalcDb.Corpus.csproj" />
    <!-- The database sort order's collation over the key codec (W-06/restricted-scalar) answers Database compare. -->
    <ProjectReference Include="..\..\src\CalcDb.Expressions\CalcDb.Expressions.csproj" />
  </ItemGroup>
</Project>
