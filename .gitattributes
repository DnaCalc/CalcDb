# LF in every working copy: the book manifest hashes the exact LF bytes.
* text=auto eol=lf
*.pdf binary
*.zip binary
*.accdb binary
*.mdb binary
*.laccdb binary
*.ldb binary
evidence/artifacts/** binary
# Pinned third-party files are kept byte for byte: their SHA-256 is checked against A-01 when they are loaded.
third_party/** -text
