      "args": [
        {
          "type": "bstr",
          "text": "SELECT ID, Qty * 2 AS DblQty, Qty * 1.5 AS FltVal, Price + 1 AS NewPrice, Cat & '-' & Name AS Tag, Null AS NullCol, CCur(Qty) AS CyQty, Qty > 15 AS BigFlag, IIf(Active, 'Y', 'N') AS ActStr INTO MT_Expr FROM Items WHERE Qty IS NOT NULL ORDER BY ID DESC"
