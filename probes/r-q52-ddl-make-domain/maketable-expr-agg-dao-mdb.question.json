          "type": "bstr",
          "text": "SELECT G.Cat, G.Label, COUNT(*) AS CntAll, COUNT(I.Qty) AS CntQty, SUM(I.Qty) AS SumQty, AVG(I.Price) AS AvgPrice, MIN(I.Dt) AS MinDt, MAX(I.Rate) AS MaxRate INTO MT_Agg FROM Groups AS G LEFT JOIN Items AS I ON G.Cat = I.Cat GROUP BY G.Cat, G.Label ORDER BY G.Cat"
