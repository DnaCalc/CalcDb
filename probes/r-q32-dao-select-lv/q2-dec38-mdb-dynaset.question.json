  "description": "Decimal(38) FDec Field.Size, Type, Attributes and Field.Value on Jet 4 MDB SELECT dynaset (type 2) across Null (ID 1, 2) and non-Null (ID 3, 4) rows, with DBEngine.Errors read immediately after Field.Value.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": ["clearErrorInfoBefore", "excepinfo", "deferredFill", "errorInfo"],
