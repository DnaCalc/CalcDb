    {
      "op": "invoke", "target": "eng", "member": "OpenDatabase", "kind": "method", "bind": "db",
      "args": [{ "type": "inputPath", "role": "main" }, { "type": "bool", "value": false }, { "type": "bool", "value": true }]
    },
    {
      "op": "invoke", "target": "db", "member": "OpenRecordset", "kind": "method", "bind": "rs",
      "args": [{ "type": "bstr", "text": "SELECT ID, FDec FROM T ORDER BY ID" }, { "type": "i4", "value": 2 }]
    },
    { "op": "invoke", "target": "rs", "member": "Fields", "kind": "propertyGet", "args": [], "bind": "fl" },
    { "op": "invoke", "target": "fl", "member": "Item", "kind": "methodOrGet", "args": [{ "type": "bstr", "text": "ID" }], "bind": "fId" },
    { "op": "invoke", "target": "fl", "member": "Item", "kind": "methodOrGet", "args": [{ "type": "bstr", "text": "FDec" }], "bind": "fDec" },
    { "op": "invoke", "target": "fDec", "member": "Name", "kind": "propertyGet", "args": [] },
    { "op": "invoke", "target": "fDec", "member": "Type", "kind": "propertyGet", "args": [] },
