            { "op": "invoke", "target": "err", "member": "Source", "kind": "propertyGet", "args": [] },
            { "op": "invoke", "target": "err", "member": "Description", "kind": "propertyGet", "args": [] }
          ]
        },
        { "op": "release", "target": "errs" },
        { "op": "invoke", "target": "rs", "member": "MoveNext", "kind": "method", "args": [] }
