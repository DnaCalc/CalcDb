{
  "schema": "calcdb.question/1",
  "probe": "r-def-cursor-dao/delete-by-other-cursor-current-row",
  "bookRefs": [
    "R-CURSOR-1",
    "CUR-LIFE",
    "CUR-POS",
    "CUR-POP"
  ],
  "description": "For a table-type (Index PK_T), a dynaset and a snapshot rs over T ordered by ID, at row 3 (Move 2) with a held ID, inside BeginTrans and rolled back: a second dynaset rd at row 3 calls Delete. On rs read BOF, EOF, ID, RecordCount; MoveNext and read; MovePrevious and read; MovePrevious and read; Edit, Errors, CancelUpdate; Requery and read. Then for a dynaset and its Clone rc: rc deletes the row that rs is on and rs is read the same way. Asks the state of a cursor whose current row another cursor, or its own clone, deleted, per type. The fixture copy is opened read-write.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
