{
  "schema": "calcdb.question/1",
  "probe": "r-def-cursor-dao/mdb-pos-dynaset",
  "bookRefs": [
    "R-CURSOR-1",
    "CUR-POS"
  ],
  "description": "On the MDB fixture, a dynaset recordset over T (table-type with Index PK_T): read Type and RecordCount, BOF, EOF, PercentPosition, AbsolutePosition and ID; MoveLast, MoveNext (past the end), MovePrevious, MoveFirst, MovePrevious (before the start), MoveNext, then Move 3, -2, 100, -100 and 0, each read the same way; a forward walk to EOF and a backward walk from MoveLast to BOF reading ID; then MoveFirst, Delete and read the state, MoveNext and read, MoveLast, Delete and read, MovePrevious and read. Asks the position, boundary and recovery states of each move on the Jet 4 format and the refusal of Delete where the type has none. The fixture copy is opened read-write. The fixture copy is opened read-write.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
  "pathBinding": "attempt-local-copy",
