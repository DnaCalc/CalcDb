{
  "schema": "calcdb.question/1",
  "probe": "r-def-cursor-dao/prov-inconsistent-referential-integrity",
  "bookRefs": [
    "R-CURSOR-1",
    "CUR-PROV",
    "CUR-EDIT"
  ],
  "description": "For OpenRecordset option dbInconsistent (16) and then dbConsistent (32) on a dynaset over PA INNER JOIN CH, each inside BeginTrans and rolled back: Edit row 1, assign PID 99, Update, EditMode, Errors, CancelUpdate; Edit, assign PAID 10 (parent key with children), Update, Errors, CancelUpdate; AddNew, assign PID 99 and W 'orphan', Update, Errors, CancelUpdate; Requery and read all rows; COUNT(*) of CH. Asks whether the declared relationship still refuses the edits under each option. The fixture copy is opened read-write.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
