{
  "schema": "calcdb.question/1",
  "probe": "r-def-cursor-dao/mdb-seek-duplicates",
  "bookRefs": [
    "R-CURSOR-1",
    "CUR-SEEK",
    "CUR-POS"
  ],
  "description": "On the MDB fixture, table-type recordsets over T with Index IX_TN (rows N 10,20,30,40,40,50,60,70): for each operator =, >=, >, <=, <, Seek with key 40 on a fresh recordset, read NoMatch, BOF, EOF and ID; MoveNext and read ID; MovePrevious twice and read ID. Then Seek \"=\" 45 and Seek \">\" 70, reading NoMatch, BOF, EOF and ID. Asks which duplicate each operator selects and the neighbours on the Jet 4 format. The fixture copy is opened read-only.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
