{
  "schema": "calcdb.question/1",
  "probe": "r-fix-cat-txn/link-schema-change-own-source",
  "bookRefs": [
    "R-LINK-1",
    "LINK-SCHEMA"
  ],
  "description": "Repairs r-enc-link/schema-change-under-cursor: the second Database altered the attempt-local input copy while the link read the unchanged fixture-creation copy, so LK still showed column N and the LINK-SCHEMA question was unanswered. A host ACCDB is made inside this probe with L and LK linked (relative Connect) to SRC of the input r-enc-link-src. LK's Fields collection is held and a dynaset on LK is held (first row read). A second Database opened read/write on the input copy of the source adds a column X and drops column N (dbFailOnError; DBEngine.Errors right before and after each). Then the held recordset continues (MoveNext, row), the held Fields are read, a new recordset on LK is opened and read, RefreshLink is called (DBEngine.Errors), and the metadata of LK and its rows are read again.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
  "pathBinding": "attempt-local-copy",
