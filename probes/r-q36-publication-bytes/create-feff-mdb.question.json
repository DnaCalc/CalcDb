{
  "schema": "calcdb.question/1",
  "probe": "r-q36-publication-bytes/create-feff-mdb",
  "bookRefs": [
    "W-05",
    "R-FMT-2",
    "II-04"
  ],
  "description": "Create Jet 4 MDB fixture for Group 1 (leading U+FEFF in Text and Memo): empty tables TD (DAO CREATE TABLE), TU (ADO CREATE TABLE, uncompressed), and TC (ADO CREATE TABLE WITH COMPRESSION). Keeps whole file after creation.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
  "pathBinding": "attempt-local-copy",
  "inputs": [],
  "program": [
    { "op": "observeFiles", "label": "before-create", "keep": false },
    { "op": "create", "progId": "DAO.DBEngine.120", "bind": "eng" },
    { "op": "observeModules", "label": "after-create" },
    {
      "op": "invoke", "target": "eng", "member": "CreateDatabase", "kind": "method",
      "args": [
        { "type": "outputPath", "fileName": "r-q36-feff-mdb.mdb" },
        { "type": "bstr", "text": ";LANGID=0x0409;CP=1252;COUNTRY=0" },
        { "type": "i4", "value": 64 }
      ],
      "bind": "db"
    },
    {
      "op": "invoke", "target": "db", "member": "Execute", "kind": "method",
      "args": [
        { "type": "bstr", "text": "CREATE TABLE TD (ID LONG CONSTRAINT PK_TD PRIMARY KEY, T TEXT(255), M MEMO)" },
        { "type": "i4", "value": 128 }
      ]
    },
    { "op": "invoke", "target": "db", "member": "Close", "kind": "method", "args": [] },
    { "op": "release", "target": "db" },
    { "op": "release", "target": "eng" },
    { "op": "create", "progId": "ADODB.Connection", "bind": "cn" },
    { "op": "invoke", "target": "cn", "member": "Provider", "kind": "propertyPut", "args": [{ "type": "bstr", "text": "Microsoft.ACE.OLEDB.12.0" }] },
    { "op": "invoke", "target": "cn", "member": "Properties", "kind": "propertyGet", "args": [], "bind": "ps" },
    { "op": "invoke", "target": "ps", "member": "Item", "kind": "methodOrGet", "args": [{ "type": "bstr", "text": "Data Source" }], "bind": "ds" },
    { "op": "invoke", "target": "ds", "member": "Value", "kind": "propertyPut", "args": [{ "type": "outputPath", "fileName": "r-q36-feff-mdb.mdb" }] },
    { "op": "release", "target": "ds" },
    { "op": "release", "target": "ps" },
    { "op": "invoke", "target": "cn", "member": "Open", "kind": "method", "args": [] },
    {
      "op": "invoke", "target": "cn", "member": "Execute", "kind": "method",
      "args": [
        { "type": "bstr", "text": "CREATE TABLE TU (ID LONG CONSTRAINT PK_TU PRIMARY KEY, T TEXT(255), M MEMO)" },
        { "type": "missing" },
        { "type": "i4", "value": 1 }
      ]
    },
    {
      "op": "invoke", "target": "cn", "member": "Execute", "kind": "method",
      "args": [
        { "type": "bstr", "text": "CREATE TABLE TC (ID LONG CONSTRAINT PK_TC PRIMARY KEY, T TEXT(255) WITH COMPRESSION, M MEMO WITH COMPRESSION)" },
        { "type": "missing" },
        { "type": "i4", "value": 1 }
      ]
    },
    { "op": "invoke", "target": "cn", "member": "Close", "kind": "method", "args": [] },
    { "op": "release", "target": "cn" },
    { "op": "observeFiles", "label": "after-create", "keep": false, "pageSize": 4096 },
    { "op": "nativeOpen", "bind": "pg", "file": "work:r-q36-feff-mdb.mdb", "access": 2147483648, "share": 7, "disposition": 3 },
    { "op": "nativeRead", "handle": "pg", "offset": 0, "count": 524288, "keep": true },
    { "op": "nativeClose", "handle": "pg" }
  ]
}
