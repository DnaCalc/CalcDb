    { "op": "invoke", "target": "eng", "member": "OpenDatabase", "kind": "method", "args": [{ "type": "outputPath", "fileName": "zf-fixed1-disc.mdb" }, { "type": "bool", "value": false }, { "type": "bool", "value": false }], "bind": "db2" },
    { "op": "invoke", "target": "db2", "member": "Execute", "kind": "method", "args": [{ "type": "bstr", "text": "UPDATE F1U SET x = NULL" }, { "type": "i4", "value": 128 }] },
