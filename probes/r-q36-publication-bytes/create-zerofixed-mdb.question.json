    { "op": "observeFiles", "label": "after-create", "keep": false, "pageSize": 4096 },
    { "op": "nativeOpen", "bind": "pg", "file": "work:r-q36-zerofixed-mdb.mdb", "access": 2147483648, "share": 7, "disposition": 3 },
    { "op": "nativeRead", "handle": "pg", "offset": 0, "count": 524288, "keep": true },
    { "op": "nativeClose", "handle": "pg" }
  ]
