  "description": "Create Jet 4 MDB fixture for Group 2 (tables with no non-Boolean fixed storage): B1, B8, B9, B17, B25, V1, V2, VM, VBin, BV, VB, plus F1/F2 controls. Keeps whole file after creation.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
  "pathBinding": "attempt-local-copy",
  "inputs": [],
  "program": [
    { "op": "observeFiles", "label": "before-create", "keep": false },
    { "op": "create", "progId": "DAO.DBEngine.120", "bind": "eng" },
    { "op": "observeModules", "label": "after-create" },
    {
      "op": "invoke", "target": "eng", "member": "CreateDatabase", "kind": "method",
      "args": [
        { "type": "outputPath", "fileName": "r-q36-zerofixed-mdb.mdb" },
        { "type": "bstr", "text": ";LANGID=0x0409;CP=1252;COUNTRY=0" },
        { "type": "i4", "value": 64 }
      ],
      "bind": "db"
    },
    { "op": "invoke", "target": "db", "member": "Execute", "kind": "method", "args": [{ "type": "bstr", "text": "CREATE TABLE B1 (b1 YESNO)" }, { "type": "i4", "value": 128 }] },
    { "op": "invoke", "target": "db", "member": "Execute", "kind": "method", "args": [{ "type": "bstr", "text": "CREATE TABLE B8 (b1 YESNO, b2 YESNO, b3 YESNO, b4 YESNO, b5 YESNO, b6 YESNO, b7 YESNO, b8 YESNO)" }, { "type": "i4", "value": 128 }] },
    { "op": "invoke", "target": "db", "member": "Execute", "kind": "method", "args": [{ "type": "bstr", "text": "CREATE TABLE B9 (b1 YESNO, b2 YESNO, b3 YESNO, b4 YESNO, b5 YESNO, b6 YESNO, b7 YESNO, b8 YESNO, b9 YESNO)" }, { "type": "i4", "value": 128 }] },
    { "op": "invoke", "target": "db", "member": "Execute", "kind": "method", "args": [{ "type": "bstr", "text": "CREATE TABLE B17 (b1 YESNO, b2 YESNO, b3 YESNO, b4 YESNO, b5 YESNO, b6 YESNO, b7 YESNO, b8 YESNO, b9 YESNO, b10 YESNO, b11 YESNO, b12 YESNO, b13 YESNO, b14 YESNO, b15 YESNO, b16 YESNO, b17 YESNO)" }, { "type": "i4", "value": 128 }] },
    { "op": "invoke", "target": "db", "member": "Execute", "kind": "method", "args": [{ "type": "bstr", "text": "CREATE TABLE B25 (b1 YESNO, b2 YESNO, b3 YESNO, b4 YESNO, b5 YESNO, b6 YESNO, b7 YESNO, b8 YESNO, b9 YESNO, b10 YESNO, b11 YESNO, b12 YESNO, b13 YESNO, b14 YESNO, b15 YESNO, b16 YESNO, b17 YESNO, b18 YESNO, b19 YESNO, b20 YESNO, b21 YESNO, b22 YESNO, b23 YESNO, b24 YESNO, b25 YESNO)" }, { "type": "i4", "value": 128 }] },
    { "op": "invoke", "target": "db", "member": "Execute", "kind": "method", "args": [{ "type": "bstr", "text": "CREATE TABLE V1 (s TEXT(50))" }, { "type": "i4", "value": 128 }] },
    { "op": "invoke", "target": "db", "member": "Execute", "kind": "method", "args": [{ "type": "bstr", "text": "CREATE TABLE V2 (s1 TEXT(50), s2 TEXT(50))" }, { "type": "i4", "value": 128 }] },
    { "op": "invoke", "target": "db", "member": "Execute", "kind": "method", "args": [{ "type": "bstr", "text": "CREATE TABLE VM (m MEMO)" }, { "type": "i4", "value": 128 }] },
    { "op": "invoke", "target": "db", "member": "Execute", "kind": "method", "args": [{ "type": "bstr", "text": "CREATE TABLE VBin (b BINARY(10))" }, { "type": "i4", "value": 128 }] },
    { "op": "invoke", "target": "db", "member": "Execute", "kind": "method", "args": [{ "type": "bstr", "text": "CREATE TABLE BV (b1 YESNO, s TEXT(50))" }, { "type": "i4", "value": 128 }] },
    { "op": "invoke", "target": "db", "member": "Execute", "kind": "method", "args": [{ "type": "bstr", "text": "CREATE TABLE VB (s TEXT(50), b1 YESNO)" }, { "type": "i4", "value": 128 }] },
    { "op": "invoke", "target": "db", "member": "Execute", "kind": "method", "args": [{ "type": "bstr", "text": "CREATE TABLE F1 (x BYTE)" }, { "type": "i4", "value": 128 }] },
    { "op": "invoke", "target": "db", "member": "Execute", "kind": "method", "args": [{ "type": "bstr", "text": "CREATE TABLE F2 (x SHORT)" }, { "type": "i4", "value": 128 }] },
    { "op": "invoke", "target": "db", "member": "Close", "kind": "method", "args": [] },
