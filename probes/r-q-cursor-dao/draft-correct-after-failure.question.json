{
  "schema": "calcdb.question/1",
  "probe": "r-q-cursor-dao/draft-correct-after-failure",
  "bookRefs": [
    "R-DAO-1",
    "DAO-DRAFT"
  ],
  "description": "DAO-DRAFT, variant: is a draft correctable after the failing call? (a) TableDef Dr1 with no fields: Append (fails), CreateField F1 Long, Fields.Append, Append again; (b) TableDef Dr2 with field F1, Name put to 'bad!name', Append (fails), Name put back to Dr2, Append; (c) on T: Index IxDraft with no fields, Indexes.Append (fails), CreateField N, Fields.Append, Indexes.Append again; (d) Relation RelDraft PA/CH with no fields, Relations.Append (fails), CreateField ID with ForeignName CID, Fields.Append, Relations.Append again. Errors and the collection Count after each call.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
