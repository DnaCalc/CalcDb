{
  "schema": "calcdb.question/1",
  "probe": "r-q-cursor-dao/id-recreate-same-name-held",
  "bookRefs": [
    "R-DAO-1",
    "DAO-ID"
  ],
  "description": "DAO-ID, variant: a held TableDef when a native table of the same name is recreated. Rc1 and Rc2 (A LONG) are created; TableDefs are refreshed and both TableDefs held. Rc1: TableDefs.Delete, then CREATE TABLE Rc1 (B TEXT(5), C LONG); Rc2: DROP TABLE, then CREATE TABLE Rc2 (B TEXT(5), C LONG). After each step the held object's Name and Fields.Count are read (Errors); then TableDefs.Refresh and the held object again; then TableDefs.Item of the name (new object) with its Fields.Count.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
  "pathBinding": "attempt-local-copy",
