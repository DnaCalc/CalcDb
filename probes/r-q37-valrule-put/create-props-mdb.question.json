    { "op": "invoke", "target": "fv", "member": "Properties", "kind": "propertyGet", "args": [], "bind": "ps1" },
    { "op": "invoke", "target": "ps1", "member": "Append", "kind": "method", "args": [{ "type": "object", "name": "pd" }] },
    { "op": "release", "target": "ps1" },
    { "op": "release", "target": "pd" },
    { "op": "invoke", "target": "fv", "member": "CreateProperty", "kind": "method", "args": [{ "type": "bstr", "text": "Format" }, { "type": "i4", "value": 10 }, { "type": "bstr", "text": "#,##0" }], "bind": "pf" },
    { "op": "invoke", "target": "fv", "member": "Properties", "kind": "propertyGet", "args": [], "bind": "ps2" },
    { "op": "invoke", "target": "ps2", "member": "Append", "kind": "method", "args": [{ "type": "object", "name": "pf" }] },
    { "op": "release", "target": "ps2" },
    { "op": "release", "target": "pf" },
