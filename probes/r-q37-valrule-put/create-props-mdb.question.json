  "pathBinding": "attempt-local-copy",
  "inputs": [],
  "program": [
    { "op": "observeFiles", "label": "before-create", "keep": false },
    { "op": "create", "progId": "DAO.DBEngine.120", "bind": "eng" },
    { "op": "observeModules", "label": "after-create" },
    {
      "op": "invoke", "target": "eng", "member": "CreateDatabase", "kind": "method",
      "args": [
        { "type": "outputPath", "fileName": "r-q37-props-mdb.mdb" },
        { "type": "bstr", "text": ";LANGID=0x0409;CP=1252;COUNTRY=0" },
        { "type": "i4", "value": 64 }
      ],
      "bind": "db"
    },
    {
      "op": "invoke", "target": "db", "member": "Execute", "kind": "method",
      "args": [
        { "type": "bstr", "text": "CREATE TABLE T (ID LONG CONSTRAINT PK PRIMARY KEY, V LONG, W TEXT(50))" },
        { "type": "i4", "value": 128 }
      ]
    },
    { "op": "invoke", "target": "db", "member": "TableDefs", "kind": "propertyGet", "args": [], "bind": "tds" },
    { "op": "invoke", "target": "tds", "member": "Item", "kind": "methodOrGet", "args": [{ "type": "bstr", "text": "T" }], "bind": "td" },
    { "op": "invoke", "target": "td", "member": "Fields", "kind": "propertyGet", "args": [], "bind": "fs" },
    { "op": "invoke", "target": "fs", "member": "Item", "kind": "methodOrGet", "args": [{ "type": "bstr", "text": "V" }], "bind": "fv" },
