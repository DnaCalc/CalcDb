{
  "schema": "calcdb.question/1",
  "probe": "r-q24-bookmarks/r2-q1-requery-partial-close",
  "bookRefs": ["R-CURSOR-1", "CUR-ID"],
  "description": "Q1 Round 2: On W, open d1 and d2 (dynasets), open s (snapshot -> 0x0900); close d1 (leaving d2 open), call s.Requery() and read s.Bookmark; close d2, call s.Requery() and read s.Bookmark.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": ["clearErrorInfoBefore", "excepinfo", "deferredFill", "errorInfo"],
  "pathBinding": "attempt-local-copy",
  "inputs": [],
  "program": [
    { "op": "observeFiles", "label": "before-open", "keep": false },
    { "op": "create", "progId": "DAO.DBEngine.120", "bind": "eng" },
    { "op": "observeModules", "label": "after-create" },
    {
      "op": "invoke", "target": "eng", "member": "CreateDatabase", "kind": "method",
      "args": [
        { "type": "outputPath", "fileName": "bookmarks.accdb" },
        { "type": "bstr", "text": ";LANGID=0x0409;CP=1252;COUNTRY=0" },
        { "type": "i4", "value": 128 }
      ],
      "bind": "db"
    },
    { "op": "invoke", "target": "db", "member": "Execute", "kind": "method", "args": [{ "type": "bstr", "text": "CREATE TABLE W (n LONG, t TEXT(10))" }, { "type": "i4", "value": 128 }] },
    { "op": "invoke", "target": "db", "member": "Execute", "kind": "method", "args": [{ "type": "bstr", "text": "INSERT INTO W (n, t) VALUES (1, 'a')" }, { "type": "i4", "value": 128 }] },
    { "op": "invoke", "target": "db", "member": "Execute", "kind": "method", "args": [{ "type": "bstr", "text": "INSERT INTO W (n, t) VALUES (2, 'b')" }, { "type": "i4", "value": 128 }] },
    { "op": "invoke", "target": "db", "member": "OpenRecordset", "kind": "method", "args": [{ "type": "bstr", "text": "W" }, { "type": "i4", "value": 2 }], "bind": "d1" },
    { "op": "invoke", "target": "db", "member": "OpenRecordset", "kind": "method", "args": [{ "type": "bstr", "text": "W" }, { "type": "i4", "value": 2 }], "bind": "d2" },
    { "op": "invoke", "target": "db", "member": "OpenRecordset", "kind": "method", "args": [{ "type": "bstr", "text": "W" }, { "type": "i4", "value": 4 }], "bind": "s" },
    { "op": "invoke", "target": "s", "member": "Bookmark", "kind": "propertyGet", "args": [] },
    { "op": "invoke", "target": "d1", "member": "Close", "kind": "method", "args": [] },
    { "op": "release", "target": "d1" },
    { "op": "invoke", "target": "s", "member": "Requery", "kind": "method", "args": [] },
    { "op": "invoke", "target": "s", "member": "Bookmark", "kind": "propertyGet", "args": [] },
    { "op": "invoke", "target": "d2", "member": "Close", "kind": "method", "args": [] },
    { "op": "release", "target": "d2" },
    { "op": "invoke", "target": "s", "member": "Requery", "kind": "method", "args": [] },
    { "op": "invoke", "target": "s", "member": "Bookmark", "kind": "propertyGet", "args": [] },
    { "op": "invoke", "target": "s", "member": "Close", "kind": "method", "args": [] },
    { "op": "release", "target": "s" },
    { "op": "invoke", "target": "db", "member": "Close", "kind": "method", "args": [] },
    { "op": "release", "target": "db" },
    { "op": "release", "target": "eng" },
    { "op": "observeFiles", "label": "after-close", "keep": false }
  ]
}
