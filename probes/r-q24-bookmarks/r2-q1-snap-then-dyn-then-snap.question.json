{
  "schema": "calcdb.question/1",
  "probe": "r-q24-bookmarks/r2-q1-snap-then-dyn-then-snap",
  "bookRefs": ["R-CURSOR-1", "CUR-ID"],
  "description": "Q1 Round 2: On W, open s1 (snap), open d1 (dyn), open s2 (snap); read s1/s2 bookmarks; close s1, open s3 (snap), read s3; close d1, open s4 (snap), read s4. Maps slot allocation and reuse across mixed dynaset/snapshot open/close.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": ["clearErrorInfoBefore", "excepinfo", "deferredFill", "errorInfo"],
  "pathBinding": "attempt-local-copy",
  "inputs": [],
  "program": [
    { "op": "observeFiles", "label": "before-open", "keep": false },
    { "op": "create", "progId": "DAO.DBEngine.120", "bind": "eng" },
    { "op": "observeModules", "label": "after-create" },
    {
      "op": "invoke", "target": "eng", "member": "CreateDatabase", "kind": "method",
      "args": [
        { "type": "outputPath", "fileName": "bookmarks.accdb" },
        { "type": "bstr", "text": ";LANGID=0x0409;CP=1252;COUNTRY=0" },
        { "type": "i4", "value": 128 }
      ],
      "bind": "db"
    },
    { "op": "invoke", "target": "db", "member": "Execute", "kind": "method", "args": [{ "type": "bstr", "text": "CREATE TABLE W (n LONG, t TEXT(10))" }, { "type": "i4", "value": 128 }] },
    { "op": "invoke", "target": "db", "member": "Execute", "kind": "method", "args": [{ "type": "bstr", "text": "INSERT INTO W (n, t) VALUES (1, 'a')" }, { "type": "i4", "value": 128 }] },
    { "op": "invoke", "target": "db", "member": "Execute", "kind": "method", "args": [{ "type": "bstr", "text": "INSERT INTO W (n, t) VALUES (2, 'b')" }, { "type": "i4", "value": 128 }] },
    { "op": "invoke", "target": "db", "member": "OpenRecordset", "kind": "method", "args": [{ "type": "bstr", "text": "W" }, { "type": "i4", "value": 4 }], "bind": "s1" },
    { "op": "invoke", "target": "s1", "member": "Bookmark", "kind": "propertyGet", "args": [] },
    { "op": "invoke", "target": "db", "member": "OpenRecordset", "kind": "method", "args": [{ "type": "bstr", "text": "W" }, { "type": "i4", "value": 2 }], "bind": "d1" },
    { "op": "invoke", "target": "db", "member": "OpenRecordset", "kind": "method", "args": [{ "type": "bstr", "text": "W" }, { "type": "i4", "value": 4 }], "bind": "s2" },
    { "op": "invoke", "target": "s2", "member": "Bookmark", "kind": "propertyGet", "args": [] },
    { "op": "invoke", "target": "s1", "member": "Close", "kind": "method", "args": [] },
    { "op": "release", "target": "s1" },
    { "op": "invoke", "target": "db", "member": "OpenRecordset", "kind": "method", "args": [{ "type": "bstr", "text": "W" }, { "type": "i4", "value": 4 }], "bind": "s3" },
    { "op": "invoke", "target": "s3", "member": "Bookmark", "kind": "propertyGet", "args": [] },
    { "op": "invoke", "target": "d1", "member": "Close", "kind": "method", "args": [] },
    { "op": "release", "target": "d1" },
    { "op": "invoke", "target": "db", "member": "OpenRecordset", "kind": "method", "args": [{ "type": "bstr", "text": "W" }, { "type": "i4", "value": 4 }], "bind": "s4" },
    { "op": "invoke", "target": "s4", "member": "Bookmark", "kind": "propertyGet", "args": [] },
    { "op": "invoke", "target": "s4", "member": "Close", "kind": "method", "args": [] },
    { "op": "release", "target": "s4" },
    { "op": "invoke", "target": "s3", "member": "Close", "kind": "method", "args": [] },
    { "op": "release", "target": "s3" },
    { "op": "invoke", "target": "s2", "member": "Close", "kind": "method", "args": [] },
    { "op": "release", "target": "s2" },
    { "op": "invoke", "target": "db", "member": "Close", "kind": "method", "args": [] },
    { "op": "release", "target": "db" },
    { "op": "release", "target": "eng" },
    { "op": "observeFiles", "label": "after-close", "keep": false }
  ]
}
