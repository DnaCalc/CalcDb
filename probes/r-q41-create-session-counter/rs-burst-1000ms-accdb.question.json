{
  "schema": "calcdb.question/1",
  "probe": "r-q41-create-session-counter/rs-burst-1000ms-accdb",
  "bookRefs": ["W-05", "W-08", "R-CRASH-1", "CRASH-ORDER", "R-FMT-1", "R-FMT-2", "fkn9"],
  "description": "ACCDB creating session (CreateDatabase option 128): two DAO dynaset Edit/Update calls separated by 1000 ms (above 500 ms burst boundary), Close, keep full file via nativeRead.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": ["clearErrorInfoBefore", "excepinfo", "deferredFill", "errorInfo"],
  "pathBinding": "attempt-local-copy",
  "inputs": [],
  "program": [
    { "op": "observeFiles", "label": "before-create", "keep": false },
    { "op": "create", "progId": "DAO.DBEngine.120", "bind": "eng" },
    { "op": "observeModules", "label": "after-create" },
    { "op": "invoke", "target": "eng", "member": "CreateDatabase", "kind": "method", "args": [{ "type": "outputPath", "fileName": "r-q41-rs-1000.accdb" }, { "type": "bstr", "text": ";LANGID=0x0409;CP=1252;COUNTRY=0" }, { "type": "i4", "value": 128 }], "bind": "db" },
    { "op": "invoke", "target": "db", "member": "Execute", "kind": "method", "args": [{ "type": "bstr", "text": "CREATE TABLE T (ID LONG, V LONG)" }, { "type": "i4", "value": 128 }] },
    { "op": "invoke", "target": "db", "member": "Execute", "kind": "method", "args": [{ "type": "bstr", "text": "INSERT INTO T VALUES (1, 10)" }, { "type": "i4", "value": 128 }] },
    { "op": "invoke", "target": "db", "member": "Execute", "kind": "method", "args": [{ "type": "bstr", "text": "INSERT INTO T VALUES (2, 20)" }, { "type": "i4", "value": 128 }] },
    { "op": "pause", "ms": 1500 },
    { "op": "invoke", "target": "db", "member": "OpenRecordset", "kind": "method", "args": [{ "type": "bstr", "text": "T" }, { "type": "i4", "value": 2 }], "bind": "rs" },
    { "op": "invoke", "target": "rs", "member": "Fields", "kind": "propertyGet", "args": [], "bind": "fs" },
    { "op": "invoke", "target": "fs", "member": "Item", "kind": "methodOrGet", "args": [{ "type": "bstr", "text": "V" }], "bind": "fv" },
    { "op": "invoke", "target": "rs", "member": "MoveFirst", "kind": "method", "args": [] },
    { "op": "invoke", "target": "rs", "member": "Edit", "kind": "method", "args": [] },
    { "op": "invoke", "target": "fv", "member": "Value", "kind": "propertyPut", "args": [{ "type": "i4", "value": 11 }] },
    { "op": "invoke", "target": "rs", "member": "Update", "kind": "method", "args": [] },
    { "op": "pause", "ms": 1000 },
    { "op": "invoke", "target": "rs", "member": "MoveNext", "kind": "method", "args": [] },
    { "op": "invoke", "target": "rs", "member": "Edit", "kind": "method", "args": [] },
    { "op": "invoke", "target": "fv", "member": "Value", "kind": "propertyPut", "args": [{ "type": "i4", "value": 22 }] },
    { "op": "invoke", "target": "rs", "member": "Update", "kind": "method", "args": [] },
    { "op": "release", "target": "fv" },
    { "op": "release", "target": "fs" },
    { "op": "invoke", "target": "rs", "member": "Close", "kind": "method", "args": [] },
    { "op": "release", "target": "rs" },
    { "op": "invoke", "target": "db", "member": "Close", "kind": "method", "args": [] },
    { "op": "release", "target": "db" },
    { "op": "release", "target": "eng" },
    { "op": "observeFiles", "label": "after-close", "keep": false, "pageSize": 4096 },
    { "op": "nativeOpen", "bind": "pg", "file": "work:r-q41-rs-1000.accdb", "access": 2147483648, "share": 7, "disposition": 3 },
    { "op": "nativeRead", "handle": "pg", "offset": 0, "count": 262144, "keep": true },
    { "op": "nativeClose", "handle": "pg" }
  ]
