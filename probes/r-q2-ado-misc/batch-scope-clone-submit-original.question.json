  "probe": "r-q2-ado-misc/batch-scope-clone-submit-original",
  "bookRefs": [
    "R-ADO-1",
    "ADO-BATCH-SCOPE"
  ],
  "description": "ADO-BATCH-SCOPE, the clone variant left F: a client batch recordset of K IDs 1 to 8 is cloned; the clone is moved to the row whose ID is read back (row 6) and its T changed; the original's pending-filter count, its row 6 value, and Recordset.Status of the current row on both are read; UpdateBatch(adAffectAll) is called on the ORIGINAL; Errors; after 8 s an independent reader; then UpdateBatch(adAffectAll) on the clone and the reader again. Asks whether a clone's pending edit belongs to the original's batch.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
