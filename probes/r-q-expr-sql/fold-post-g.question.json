{
  "schema": "calcdb.question/1",
  "probe": "r-q-expr-sql/fold-post-g",
  "bookRefs": [
    "R-PAR-1",
    "PAR-FOLD",
    "SQL-AGG-ORDER",
    "SQL-AGG-FIRST"
  ],
  "description": "Double fold order, one thing varied: FL with an index on g only, created on FL after the rows exist. Asks the same reads as the fold-scan probes (Sum for WHERE g = 3, 1, 2 and GROUP BY g, First/Last, the group-3 scan order and the first 40 ids) after the CREATE INDEX statements, so that an index built after load can be told from one maintained during load (FLI, FLG, FLD). Follow-up probe (status F) for PAR-FOLD, SQL-AGG-ORDER, SQL-AGG-FIRST; runs on a writable fresh copy of fixture r-q-expr-sql-fold through DAO.DBEngine.120; each recordset reads Name, Type and Value of every field. Each statement is preceded by a marker (a DROP TABLE of a table that does not exist, which always fails), so DBEngine.Errors read after the statement shows that statement's own failure or the marker's, never an older one.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
