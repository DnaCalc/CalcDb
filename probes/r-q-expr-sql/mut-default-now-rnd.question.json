  "probe": "r-q-expr-sql/mut-default-now-rnd",
  "bookRefs": [
    "R-EXPR-1",
    "EXPR-MUTATION",
    "EXPR-RUNTIME"
  ],
  "description": "EXPR-MUTATION and EXPR-RUNTIME, deciding variant: when a clock or random default is sampled. MD(ID, T DATETIME default Now(), R DOUBLE default Rnd()): AddNew, read T and R, wait 2.1 s, read them again, put ID = 1 and Update; then AddNew a second row immediately, read T and R, CancelUpdate, AddNew again, read, put ID = 3 and Update; the stored rows are read last. Follow-up probe (status F) for EXPR-MUTATION, EXPR-RUNTIME; runs on a writable fresh copy of fixture r-q-expr-sql-main through DAO.DBEngine.120; each recordset reads Name, Type and Value of every field. Each statement is preceded by a marker (a DROP TABLE of a table that does not exist, which always fails), so DBEngine.Errors read after the statement shows that statement's own failure or the marker's, never an older one.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
