  "probe": "r-q-cat-txn-lock/write-timing-unindexed-field-page-mode",
  "bookRefs": [
    "R-LOCK-4",
    "WRITE-TIMING",
    "R-TXN-1",
    "TXN-LOCAL"
  ],
  "description": "WRITE-TIMING, record versus page ownership (rows 1 and 2 are blocked even with ADO 'Jet OLEDB:Database Locking Mode=0', which may be the shared IX_N leaf rather than the data page). Process a is the first opener through an ADODB.Connection with that locking mode (value read back), starts a pessimistic edit by assigning the UNINDEXED field V of row 1 and holds it; process b (DAO) tries with Errors before/after UPDATE V of row 2 (same page, unindexed field), UPDATE N of row 2 (indexed field), UPDATE V of row 64, and INSERT; a CancelUpdate and closes; b repeats row 2 V (control). Asks whether the unindexed-field update on a same-page row is admitted in row mode and blocked in page mode.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
