{
  "schema": "calcdb.question/1",
  "probe": "r-q-cat-txn-lock/ro-three-readers-and-reads-after-writer",
  "bookRefs": [
    "R-LOCK-2",
    "RO-PAIR",
    "RO-LATE",
    "RO-ACTUAL"
  ],
  "description": "RO-PAIR with three readers, and RO-LATE with readers that read after the writer. Processes a, b, c each open DAO shared read-only in turn and hold a recordset. Process d then opens shared read/write, updates S of row 1 (dbFailOnError, RecordsAffected), tries an exclusive open and a native read/write share-zero handle (all with Errors before/after). Each reader then pauses 7 s, Idle(dbRefreshCache) and reads S of row 1 through a new snapshot and its held recordset's count; d finally reopens and reads S (independent read). Asks whether three readers coexist, whether the writer is admitted beside them, and whether the readers read an intact file and the writer's value.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
