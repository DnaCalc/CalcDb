{
  "schema": "calcdb.question/1",
  "probe": "r-q-cat-txn-lock/txn-multi-two-workspaces-opposite-order",
  "bookRefs": [
    "R-TXN-1",
    "TXN-MULTI"
  ],
  "description": "TXN-MULTI, two Workspaces with opposing participant order, one process. Workspace w1 opens main (A) then second (B); w2 opens B then A. Both BeginTrans; w1 updates A row 1 then B row 1; w2 updates B row 3 then A row 64 (Errors before/after each); phase 1: w1 Rollback then w2 CommitTrans; phase 2: both begin again, same changes, w1 CommitTrans then w2 Rollback. After each phase the rows are read, and finally a third Workspace reads after a 7 s pause and Idle. Asks whether participant order matters for resolution and whether the Workspaces' changes stay separate.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
