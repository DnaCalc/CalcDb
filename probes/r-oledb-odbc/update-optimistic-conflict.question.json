{
  "schema": "calcdb.question/1",
  "probe": "r-oledb-odbc/update-optimistic-conflict",
  "bookRefs": [
    "R-OLEDB-1",
    "OLE-UPDATE",
    "OLE-ERROR"
  ],
  "description": "OLE-UPDATE optimistic conflicts across processes: process A reads row 1 through a server keyset optimistic Recordset; B changes row 1's Txt and deletes row 3; A sets Txt on row 1 and reads Value, OriginalValue and UnderlyingValue, calls Update (EditMode, Status, Errors), CancelUpdate, Resync(adAffectCurrent, adResyncUnderlyingValues) and the values again, then edits and updates a second time; A then edits the deleted row 3, Updates, reads Status and Errors, CancelUpdate and Resync. Asks how a stale update and a deleted row are reported and what the values read as.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
