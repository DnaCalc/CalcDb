{
  "schema": "calcdb.question/1",
  "probe": "r-oledb-odbc/act-services-variants",
  "bookRefs": [
    "R-OLEDB-1",
    "OLE-ACT",
    "OLE-PROP"
  ],
  "description": "OLE-ACT: five Connections open the same file with connection strings 'Provider=ACE;OLE DB Services=<v>;Mode=Read' for v = -1, -2, -4, -5 and 0 (Data Source through Properties). For each: State, loaded modules after Open, the properties OLE DB Services, Provider Name and Active Sessions, then a client-cursor static and a server keyset Recordset open on Items (State, RecordCount, loaded modules, Connection Errors), Close and loaded modules. Asks which service components the provider selection loads and whether a client cursor still opens.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
