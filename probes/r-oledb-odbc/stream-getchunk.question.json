{
  "schema": "calcdb.question/1",
  "probe": "r-oledb-odbc/stream-getchunk",
  "bookRefs": [
    "R-OLEDB-1",
    "OLE-STREAM",
    "OLE-BUFFER"
  ],
  "description": "OLE-STREAM output as projected by ADO, on a server forward-only and a client static read-only Recordset of 'SELECT ID, B, M FROM Items': for row 1 read ActualSize and GetChunk(3) five times of the ten-byte binary then Value; rows 2 and 3 (Null, empty) GetChunk(3); row 4 (12,000-byte binary, 12,000-character memo) GetChunk(4096) and GetChunk(5000) interleaved between the two fields until exhausted, then GetChunk(0), GetChunk(-1), GetChunk(65536) and Value. Asks the piece sizes, the exhausted-call result and whether reading chunks interferes with Value.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
