{
  "schema": "calcdb.question/1",
  "probe": "r-oledb-odbc/error-open-failures",
  "bookRefs": [
    "R-OLEDB-1",
    "OLE-ERROR",
    "OLE-ACT"
  ],
  "description": "OLE-ERROR on Open: separate Connections attempt (a) a Data Source that does not exist, (b) no Data Source, (c) an empty Data Source, (d) Extended Properties=\"Excel 12.0 Xml;HDR=Yes\" against the Access file, (e) Extended Properties=Text, (f) User ID Admin with Password wrongpw, (g) Mode 99, and (h) in one process a first read/write exclusive Connection with a second read/write Connection, then a first shared with a second exclusive. After each: State, Provider, ConnectionString and every Errors entry; then Close and release. Asks the failure channel and values of each refusal.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
