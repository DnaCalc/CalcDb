{
  "schema": "calcdb.question/1",
  "probe": "r-cursor-1b/update-arguments",
  "bookRefs": [
    "R-CURSOR-1",
    "D-CURSOR-1",
    "CUR-EDIT"
  ],
  "description": "For each Update argument list [(no argument) ;; Long 1 ;; Long 2 ;; Long 3 ;; Long 1, True ;; Missing, True ;; Null ;; \"1\" ;; Long 0 ;; Long 4 ;; Long 1, False]: fresh dynaset over F with held Field N, Edit row 1, assign N 301+index, Update with the arguments, read EditMode, Errors; Move 0 and read N; CancelUpdate if needed, close. Asks the accepted UpdateType and Force values and whether an Update with them posts the edit. The fixture copy is opened read-write.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
