  "probe": "r-cursor-1b/sort-expression-forms",
  "bookRefs": [
    "R-CURSOR-1",
    "D-CURSOR-1",
    "CUR-LIFE",
    "CUR-POS"
  ],
  "description": "For each Sort value in turn [N DESC ;; S ;; S DESC, N ;; D ;; D DESC ;; ID DESC ;; [S] ASC ;; N DESC, ID DESC ;; Q ;; F.N ;; N + 1 ;; NoSuchField ;;  ;; N ASC, N DESC ;; N DESCENDING ;; ORDER BY N ;; Null ;; Long 1]: open a fresh dynaset over F, assign Sort, read Sort back, call OpenRecordset() with no arguments into a derived recordset and walk ID to EOF; close both. Asks which Sort texts are accepted at assignment and at the derived OpenRecordset, the order of the derived rows (text collation, Null placement, ties) and the Sort the derived recordset reports. The fixture copy is opened read-only.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
