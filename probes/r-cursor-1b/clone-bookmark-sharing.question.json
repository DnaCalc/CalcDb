{
  "schema": "calcdb.question/1",
  "probe": "r-cursor-1b/clone-bookmark-sharing",
  "bookRefs": [
    "R-CURSOR-1",
    "D-CURSOR-1",
    "CUR-LIFE",
    "CUR-ID"
  ],
  "description": "Dynaset P over F, Clone C, independent dynaset Q, snapshot S and its clone SC. Read Bookmark of P, C and Q each at row 3 (Move 2; for C and Q MoveFirst first), and of S and SC at row 3. Then, for each of P, C, Q, S and SC: MoveFirst, assign Bookmark the constant (2,2,0,0) (dynaset pattern) and then (2,3,0,0) (snapshot pattern), reading BOF, EOF and ID after each assignment and the cursor's own Bookmark. Close P and assign (2,2,0,0) to C. Asks whether a bookmark constant is accepted by another cursor, a clone and a different recordset type, and whether a clone survives the parent. The fixture copy is opened read-only.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
  "pathBinding": "attempt-local-copy",
