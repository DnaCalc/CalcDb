{
  "schema": "calcdb.question/1",
  "probe": "r-cursor-1b/filter-sort-query-source",
  "bookRefs": [
    "R-CURSOR-1",
    "D-CURSOR-1",
    "CUR-LIFE",
    "CUR-POP"
  ],
  "description": "For each SQL source [SELECT ID, N, S FROM F WHERE N < 60 ORDER BY N DESC | Filter N > 20 | Sort ID ;; SELECT ID, N FROM F ORDER BY S | Filter N > 20 | Sort N DESC ;; SELECT TOP 3 ID, N FROM F ORDER BY N DESC | Filter N < 70 | Sort ID ;; SELECT N, COUNT(*) AS Cnt FROM F GROUP BY N | Filter Cnt > 1 | Sort N DESC]: open a dynaset, read Type, Filter and Sort, walk the listed fields to EOF; set Filter and Sort; call OpenRecordset() with no arguments; read the derived Type, Filter and Sort and walk the fields. Asks how Filter and Sort compose with the source's own WHERE, ORDER BY, TOP and GROUP BY in the derived recordset and whether the source recordset's rows change. The fixture copy is opened read-only.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
