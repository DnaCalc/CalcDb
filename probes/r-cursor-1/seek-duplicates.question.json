{
  "schema": "calcdb.question/1",
  "probe": "r-cursor-1/seek-duplicates",
  "bookRefs": [
    "R-CURSOR-1",
    "D-CURSOR-1",
    "CUR-SEEK"
  ],
  "description": "Table D has K values 1,2,2,2,3,Null for IDs 1-6. For each operator = >= > <= < with key 2 on Index IX_K: fresh table-type recordset, Seek, read NoMatch, ID, K; MoveNext and read ID; MovePrevious twice and read ID. Then Seek \"=\", Null on IX_K and on IX_KN (WITH IGNORE NULL), reading NoMatch and ID; then on IX_KN MoveFirst and walk ID to EOF. Asks which duplicate each operator selects and how Null keys and an ignore-null index take part. The fixture copy is opened read-only.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
