{
  "schema": "calcdb.question/1",
  "probe": "r-cursor-1/seek-duplicates-multileaf",
  "bookRefs": [
    "R-CURSOR-1",
    "D-CURSOR-1",
    "CUR-SEEK"
  ],
  "description": "Table DL has 256 rows (IDs 1-256) sharing one 200-character K over several index pages, plus (1001,'a') and (1002,'z'). For each operator = >= > <= < with that long K on Index IX_K: fresh table-type recordset, Seek, read NoMatch and ID; MoveNext and read ID; MovePrevious twice and read ID. Asks which member of a duplicate group spanning index leaves each operator selects, and its neighbours. The fixture copy is opened read-only.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
