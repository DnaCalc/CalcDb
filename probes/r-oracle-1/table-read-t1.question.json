{
  "schema": "calcdb.question/1",
  "probe": "r-oracle-1/table-read-t1",
  "bookRefs": ["W-01", "R-ORACLE-1", "OR-IDENT", "OR-WIRE", "OR-OBS", "II-16 §33", "T-EVID-05", "T-EVID-06"],
  "description": "First genuine table read (II-16 §33): open the frozen T1 fixture read-only through ACE DAO, open a table-type recordset on T1, record field metadata, then read every field value of every row with MoveNext until EOF. File state is observed before open, while open and after close.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": ["clearErrorInfoBefore", "excepinfo", "deferredFill", "errorInfo"],
  "pathBinding": "attempt-local-copy",
  "inputs": [ { "role": "main", "fileName": "r-oracle-1-t1.accdb", "sha256": "486e67a3af61f4fedf267d3345b50d0b3dc6e10db7dea76bc93a2aad8fc57b32", "length": 200704, "provenance": "r-oracle-1-create-fixture-t1.a1 qk1-c3b69c6590bc0f47ff2cd8852af27dad19c66e6cbde0307234c59d371d26f215 output:r-oracle-1-t1.accdb" } ],
  "program": [
    { "op": "observeFiles", "label": "before-open" },
    { "op": "observeModules", "label": "before-create" },
    { "op": "create", "progId": "DAO.DBEngine.120", "bind": "eng" },
    { "op": "observeModules", "label": "after-create" },
    { "op": "invoke", "target": "eng", "member": "Version", "kind": "propertyGet", "args": [] },
    { "op": "invoke", "target": "eng", "member": "OpenDatabase", "kind": "method", "bind": "db", "args": [
      { "type": "inputPath", "role": "main" }, { "type": "bool", "value": false }, { "type": "bool", "value": true } ] },
    { "op": "observeFiles", "label": "after-open" },
    { "op": "invoke", "target": "db", "member": "OpenRecordset", "kind": "method", "bind": "rs", "args": [
      { "type": "bstr", "text": "T1" }, { "type": "i4", "value": 1 } ] },
    { "op": "invoke", "target": "rs", "member": "Type", "kind": "propertyGet", "args": [] },
    { "op": "invoke", "target": "rs", "member": "RecordCount", "kind": "propertyGet", "args": [] },
    { "op": "invoke", "target": "rs", "member": "Fields", "kind": "propertyGet", "bind": "flds", "args": [] },
    { "op": "forEachItem", "target": "flds", "bind": "f", "maxItems": 16, "body": [
      { "op": "invoke", "target": "f", "member": "Name", "kind": "propertyGet", "args": [] },
      { "op": "invoke", "target": "f", "member": "Type", "kind": "propertyGet", "args": [] },
      { "op": "invoke", "target": "f", "member": "Size", "kind": "propertyGet", "args": [] } ] },
    { "op": "loopUntil", "target": "rs", "member": "EOF", "maxIterations": 16, "body": [
      { "op": "forEachItem", "target": "flds", "bind": "f", "maxItems": 16, "body": [
        { "op": "invoke", "target": "f", "member": "Value", "kind": "propertyGet", "args": [] } ] },
      { "op": "invoke", "target": "rs", "member": "MoveNext", "kind": "method", "args": [] } ] },
    { "op": "release", "target": "flds" },
    { "op": "invoke", "target": "rs", "member": "Close", "kind": "method", "args": [] },
    { "op": "release", "target": "rs" },
    { "op": "invoke", "target": "db", "member": "Close", "kind": "method", "args": [] },
    { "op": "release", "target": "db" },
    { "op": "release", "target": "eng" },
    { "op": "observeModules", "label": "after-close" },
    { "op": "observeFiles", "label": "after-close" }
  ]
