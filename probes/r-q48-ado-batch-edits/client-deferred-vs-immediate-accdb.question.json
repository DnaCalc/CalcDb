    "II-12"
  ],
  "description": "ACCDB: side-by-side page-byte discriminator between client static batch-optimistic (3,3,4) and client static optimistic (3,3,3) on W. Phase 1 (batch-optimistic): Put+Update, AddNew+Update, Delete (keeps all pages after each -> 0 bytes), then UpdateBatch (keeps all pages -> exact 0xE02/page-1/row/index bytes), pause, Close. Phase 2 (client optimistic): Put+Update, AddNew+Update, Delete (keeps all pages after each -> immediate commits), pause, Close.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
