{
  "schema": "calcdb.question/1",
  "probe": "r-fmt-2-pres-1/scalar-admission",
  "bookRefs": [
    "R-FMT-2",
    "Scalar boundaries",
    "NUMERIC",
    "Dates / GUID",
    "Generated values"
  ],
  "description": "Scalar admission through a table recordset into Sc, one row per attempt (each row sets one field): Byte 255, 256 and -1; Integer min/max and 32768; Long min; Single subnormal, NaN, infinity; Double -0, subnormal, NaN, infinity; Currency max, overflow and a tie string; Date -1.5, -1, -0.5, 0, a sub-millisecond fraction and out-of-range; GUID in braced, unbraced and 16-byte forms; Decimal as strings and a Currency; extended date/time strings with a seven-digit tick and an eighth-digit tie. Typed values read back for every row; one image after all of them. Images: 'before' (the fixture copy as given), then one kept image of the closed file after each step; every step opens the database read/write, makes one mutation and closes it.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
