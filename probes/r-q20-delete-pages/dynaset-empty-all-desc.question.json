{
  "schema": "calcdb.question/1",
  "probe": "r-q20-delete-pages/dynaset-empty-all-desc",
  "bookRefs": [
    "R-FMT-2",
    "W-05/growth-structural-closure",
    "Overflow / deletion",
    "Map ownership and growth",
    "R-CURSOR-1 CUR-POP",
    "R-TXN-1 TXN-FLUSH-BEHIND"
  ],
  "description": "A copy of the r-fmt-2b-w-accdb fixture (123 pages; page 122, Au4's old data page, is the only free page inside the file). Pg: tdef 52, usage maps 53 (owned {55, 56, 57}, FreeMap {57}), PK root 54, 12 plain rows of ID and eight Text(255) fields of 61 U+20AC (1004 bytes each, no long values); rows 1-4 fill page 55 (slots 0-3 at 0c14, 0828, 043c, 0050; 58 bytes free), 5-8 page 56, 9-12 page 57. One shared session opens a dynaset on SELECT * FROM Pg ORDER BY ID DESC and runs Delete then MoveNext twelve times (descending (ID 12-1: empties page 57 at Delete 4, page 56 at Delete 8, page 55 at Delete 12)). After Deletes 4, 8 and 12 (each followed by a 1.5 s pause), after Recordset.Close (1.5 s pause), and after Database.Close, the pages are read. Asks whether dynaset Deletes release emptied pages, when, and which page stays owned. Reads keep pages 0, 1, 52, 53, 54, 55, 56, 57 before and after (and hash pages 0-125 after each Close).",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
