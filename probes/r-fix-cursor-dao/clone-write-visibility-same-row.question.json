{
  "schema": "calcdb.question/1",
  "probe": "r-fix-cursor-dao/clone-write-visibility-same-row",
  "bookRefs": [
    "R-CURSOR-1",
    "D-CURSOR-1",
    "CUR-LIFE",
    "CUR-POP",
    "CUR-EDIT"
  ],
  "description": "Repairs r-cursor-1b/clone-write-visibility: the clone was not on the row the parent was on when it deleted, so its Delete removed ID 2 and not the row the parent stood on (ID 9); the cross-clone delete of the same row was not tested. Dynaset P over F at row 2 (Move 1), held Fields N and S; Clone C; C MoveFirst and Move 1 so that it is on row 2, read both IDs; C: Edit, assign S \"clone\" and N 222, Update. Read P's held S and N, C's; P.Move 0 and read; P.MoveNext, P.MovePrevious, read. C: AddNew, assign ID 9, N 99, S \"cn\", Update; read P's RecordCount; P.MoveLast and C.MoveLast, read both IDs; read C's RecordCount. C: Delete (its current row is the row P stands on); read P's BOF, EOF, ID and held S, P.Move 0, read again. Then P.MoveFirst and C.MoveFirst, read both IDs; P: Delete; read C's BOF, EOF and ID, C.Move 0, read, C.Requery, read. Asks which edits, additions and deletions of one and the same row made through one family member the other sees without Requery, and the state after each. The fixture copy is opened read-write.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
