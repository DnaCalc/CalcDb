{
  "schema": "calcdb.question/1",
  "probe": "r-q40-mdb-counter/create-first-write-accdb",
  "bookRefs": ["W-05", "W-07", "W-08", "R-CRASH-1", "CRASH-ORDER", "R-FMT-1", "3vkh"],
  "description": "ACCDB twin: CreateDatabase (option 128), run first CREATE TABLE inside the exclusive creation session, Close and read all pages; then reopen shared, run first INSERT, pause 1500 ms, read while open, Close and read all pages.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": ["clearErrorInfoBefore", "excepinfo", "deferredFill", "errorInfo"],
  "pathBinding": "attempt-local-copy",
  "inputs": [],
  "program": [
    { "op": "observeFiles", "label": "before-create", "keep": false },
    { "op": "create", "progId": "DAO.DBEngine.120", "bind": "eng" },
    { "op": "observeModules", "label": "after-create" },
    { "op": "invoke", "target": "eng", "member": "CreateDatabase", "kind": "method", "args": [{ "type": "outputPath", "fileName": "r-q40-first-write.accdb" }, { "type": "bstr", "text": ";LANGID=0x0409;CP=1252;COUNTRY=0" }, { "type": "i4", "value": 128 }], "bind": "db0" },
    { "op": "invoke", "target": "db0", "member": "Execute", "kind": "method", "args": [{ "type": "bstr", "text": "CREATE TABLE T (ID LONG, V LONG)" }, { "type": "i4", "value": 128 }] },
    { "op": "invoke", "target": "db0", "member": "Close", "kind": "method", "args": [] },
    { "op": "release", "target": "db0" },
    { "op": "observeFiles", "label": "after-create-write-close", "keep": false, "pageSize": 4096 },
    { "op": "nativeOpen", "bind": "pg0", "file": "work:r-q40-first-write.accdb", "access": 2147483648, "share": 7, "disposition": 3 },
    { "op": "nativeRead", "handle": "pg0", "offset": 0, "count": 262144, "keep": true },
    { "op": "nativeClose", "handle": "pg0" },
    { "op": "invoke", "target": "eng", "member": "OpenDatabase", "kind": "method", "args": [{ "type": "outputPath", "fileName": "r-q40-first-write.accdb" }, { "type": "bool", "value": false }, { "type": "bool", "value": false }], "bind": "db1" },
    { "op": "invoke", "target": "db1", "member": "Execute", "kind": "method", "args": [{ "type": "bstr", "text": "INSERT INTO T VALUES (1, 10)" }, { "type": "i4", "value": 128 }] },
    { "op": "pause", "ms": 1500 },
    { "op": "observeFiles", "label": "after-shared-ins-open", "keep": false, "pageSize": 4096 },
    { "op": "nativeOpen", "bind": "pg1", "file": "work:r-q40-first-write.accdb", "access": 2147483648, "share": 7, "disposition": 3 },
    { "op": "nativeRead", "handle": "pg1", "offset": 0, "count": 262144, "keep": true },
    { "op": "nativeClose", "handle": "pg1" },
    { "op": "invoke", "target": "db1", "member": "Close", "kind": "method", "args": [] },
    { "op": "release", "target": "db1" },
    { "op": "release", "target": "eng" },
    { "op": "observeFiles", "label": "after-shared-ins-close", "keep": false, "pageSize": 4096 },
    { "op": "nativeOpen", "bind": "pg2", "file": "work:r-q40-first-write.accdb", "access": 2147483648, "share": 7, "disposition": 3 },
    { "op": "nativeRead", "handle": "pg2", "offset": 0, "count": 262144, "keep": true },
    { "op": "nativeClose", "handle": "pg2" }
  ]
