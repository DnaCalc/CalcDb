{
  "schema": "calcdb.question/1",
  "probe": "r-q-ado-misc/props-failed-open",
  "bookRefs": [
    "R-ADO-1",
    "ADO-PROPS",
    "ADO-CONN"
  ],
  "description": "ADO-PROPS after a failed Open: Provider set to ACE, Data Source an absent file; Open fails; State, ConnectionString, Properties.Count, every property's Name and Value, Errors. Asks what the failed open leaves in the inventory.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
  "pathBinding": "attempt-local-copy",
  "inputs": [],
  "program": [
    {
      "op": "observeFiles",
      "label": "before-open",
      "keep": false
    },
    {
      "op": "create",
      "progId": "DAO.DBEngine.120",
      "bind": "eng"
    },
    {
      "op": "observeModules",
      "label": "after-create"
    },
    {
      "op": "create",
      "progId": "ADODB.Connection",
      "bind": "cn"
    },
    {
      "op": "invoke",
      "target": "cn",
      "member": "Provider",
      "kind": "propertyPut",
      "args": [
        {
          "type": "bstr",
          "text": "Microsoft.ACE.OLEDB.12.0"
        }
      ]
    },
    {
      "op": "invoke",
      "target": "cn",
      "member": "Properties",
      "kind": "propertyGet",
      "args": [],
      "bind": "cnPr"
    },
    {
      "op": "invoke",
      "target": "cnPr",
      "member": "Item",
      "kind": "methodOrGet",
      "args": [
        {
          "type": "bstr",
          "text": "Data Source"
        }
      ],
      "bind": "cnDs"
    },
    {
      "op": "invoke",
      "target": "cnDs",
      "member": "Value",
      "kind": "propertyPut",
      "args": [
        {
          "type": "outputPath",
          "fileName": "scratch-props-absent.accdb"
        }
      ]
    },
    {
      "op": "release",
      "target": "cnDs"
    },
    {
      "op": "release",
      "target": "cnPr"
    },
    {
      "op": "invoke",
      "target": "cn",
      "member": "Open",
      "kind": "method",
      "args": []
    },
    {
      "op": "invoke",
      "target": "cn",
      "member": "State",
      "kind": "propertyGet",
      "args": []
    },
    {
      "op": "invoke",
      "target": "cn",
      "member": "ConnectionString",
      "kind": "propertyGet",
      "args": []
    },
    {
      "op": "invoke",
      "target": "cn",
      "member": "Errors",
      "kind": "propertyGet",
      "args": [],
      "bind": "cnErrs"
    },
    {
      "op": "forEachItem",
      "target": "cnErrs",
      "bind": "cnErr",
      "maxItems": 16,
      "body": [
        {
          "op": "invoke",
          "target": "cnErr",
          "member": "Number",
          "kind": "propertyGet",
          "args": []
        },
        {
          "op": "invoke",
          "target": "cnErr",
          "member": "Description",
          "kind": "propertyGet",
          "args": []
        },
        {
          "op": "invoke",
          "target": "cnErr",
          "member": "Source",
          "kind": "propertyGet",
          "args": []
        },
        {
          "op": "invoke",
          "target": "cnErr",
          "member": "SQLState",
          "kind": "propertyGet",
          "args": []
        },
        {
          "op": "invoke",
          "target": "cnErr",
          "member": "NativeError",
          "kind": "propertyGet",
          "args": []
        }
      ]
    },
    {
      "op": "release",
      "target": "cnErrs"
    },
    {
      "op": "invoke",
      "target": "cn",
      "member": "Errors",
      "kind": "propertyGet",
      "args": [],
      "bind": "cnEc"
    },
    {
      "op": "invoke",
      "target": "cnEc",
      "member": "Clear",
      "kind": "method",
      "args": []
    },
    {
      "op": "release",
      "target": "cnEc"
    },
    {
      "op": "invoke",
      "target": "cn",
      "member": "Properties",
      "kind": "propertyGet",
      "args": [],
      "bind": "pr"
    },
    {
      "op": "invoke",
      "target": "pr",
      "member": "Count",
      "kind": "propertyGet",
      "args": []
    },
    {
      "op": "forEachItem",
      "target": "pr",
      "bind": "pp",
      "maxItems": 140,
      "body": [
        {
          "op": "invoke",
          "target": "pp",
          "member": "Name",
          "kind": "propertyGet",
          "args": []
        },
        {
          "op": "invoke",
          "target": "pp",
          "member": "Value",
          "kind": "propertyGet",
          "args": []
        }
      ]
    },
    {
      "op": "release",
      "target": "pr"
    },
    {
      "op": "observeFiles",
      "label": "after-close",
      "keep": false
    }
  ]
}
