{
  "schema": "calcdb.question/1",
  "probe": "r-q2-cursor-dao/errpart-lock-multipage-failonerror",
  "bookRefs": [
    "R-ERR-1",
    "ERR-PARTIAL"
  ],
  "description": "ERR-PARTIAL (F: lock granularity on a table spanning many pages), variant: with dbFailOnError. A second Workspace W2 opens the file; a dynaset on Big (2048 rows, about 100 pages) with LockEdits True runs FindFirst ID = k and Edit for k = 1, 1000 and 2048; for each k the first Database runs UPDATE Big SET V = 'u' with dbFailOnError; Errors, RecordsAffected, COUNT of rows with V = 'u' and their MIN and MAX ID are read; W2 cancels and closes; the rows are reset (UPDATE ... WHERE V = 'u'). Decides whether rows on pages other than the locked row's page are updated or refused.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
