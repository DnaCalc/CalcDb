{
  "schema": "calcdb.question/1",
  "probe": "r-par-1/err-top-stops-before-bad-row",
  "bookRefs": [
    "R-PAR-1",
    "PAR-ERROR",
    "SQL-DEMAND",
    "SQL-TOP-01"
  ],
  "description": "R-PAR-1 PAR-ERROR, SQL-DEMAND, SQL-TOP-01: With zm = 0 at id 100 (and zl = 0 at id 240), does TOP stop before the bad row without error, and when is the error raised if the cutoff includes it: TOP 10 with no ORDER BY; ORDER BY id; ORDER BY id DESC; TOP 150 and TOP 99 and TOP 100 with ORDER BY id; TOP 5 ORDER BY 1 / zm; TOP 239 and TOP 240 over zl with ORDER BY id; and TOP 10, 50 and 100 PERCENT of the rows (one GetRows(300) per statement)? Runs on a fresh copy of r-par-1-error opened read-only through DAO OpenDatabase in one process and one STA; each statement is opened with Database.OpenRecordset as a snapshot unless stated, and every call's result, HRESULT and DBEngine.Errors are captured.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
