{
  "schema": "calcdb.question/1",
  "probe": "r-ado-1b/batch-resubmit",
  "bookRefs": [
    "R-ADO-1",
    "ADO-BATCH"
  ],
  "description": "ADO-BATCH resubmission on a client static batch-optimistic Recordset of SELECT ID, Code, V, V2, S FROM W ORDER BY ID (read/write copy): stage an inserted row (ID 20, Code \"w20\", S \"ins\"), Code of row 2 set to the duplicate \"w1\" and S of row 3; UpdateBatch(adAffectAll) (Errors, each row's Status and Code, stored rows for IDs 1-3 and 20); then Find ID 2, set its Code to \"w2x\", UpdateBatch(adAffectAll) again (Errors, Status, stored rows); and a third UpdateBatch with nothing pending. Asks which staged rows the first submission applied, whether accepted rows are sent again and what the resubmission reports.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
