{
  "schema": "calcdb.question/1",
  "probe": "r-ado-1b/conn-set-while-open",
  "bookRefs": [
    "R-ADO-1",
    "ADO-CONN",
    "ADO-PROPS"
  ],
  "description": "ADO-CONN assignment on an open read/write Connection: read the state; then, one at a time with the value read back and the Errors read and cleared after each, assign ConnectionString (another string), Provider (MSDASQL), Mode (adModeRead), CursorLocation (client), CommandTimeout (5), IsolationLevel (serializable), DefaultDatabase (\"x\"), Attributes (retaining) and the properties Data Source (a work file) and Jet OLEDB:Database Locking Mode (1); then Close, read the state again, Open() again and read the state. Asks which assignments an open Connection accepts or refuses and which values survive Close and Open.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
