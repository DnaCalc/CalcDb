{
  "schema": "calcdb.question/1",
  "probe": "r-ado-1b/conn-open-args",
  "bookRefs": [
    "R-ADO-1",
    "ADO-CONN"
  ],
  "description": "ADO-CONN Open arguments: seven Connections with Provider (or a ConnectionString), Data Source through Properties and Mode = adModeRead, each opened with a different (ConnectionString, UserID, Password, Options) argument list: (UserID \"Admin\", empty Password), (\"Admin\", \"pw\"), (\"nouser\", empty), Options -1, Options 99, UserID and Password Null, and a ConnectionString property holding \"User ID=Admin\" with UserID argument \"other\". After each Open read State, ConnectionString and Errors, then Close. Asks which arguments the provider and ADO accept and how a string value and an argument combine.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
