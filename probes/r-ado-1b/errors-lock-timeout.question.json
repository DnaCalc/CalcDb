{
  "schema": "calcdb.question/1",
  "probe": "r-ado-1b/errors-lock-timeout",
  "bookRefs": [
    "R-ADO-1",
    "R-ERR-1",
    "ADO-RESULTS",
    "R-LOCK-4"
  ],
  "description": "R-ERR-1 and ADO-RESULTS lock wait inside one process (read/write copy): a second Connection BeginTrans and UPDATEs S of W row 1 without committing; the first Connection (CommandTimeout 2) then runs an UPDATE of the same row through Execute, through a Command (CommandTimeout 1), and through a server keyset optimistic Recordset edit and Update of row 1; each reads State, the Errors (Number, Description, Source, SQLState, NativeError, cleared); the second Connection then RollbackTrans and the first UPDATE runs again; the stored row is read. Asks the lock-failure error for each route, whether CommandTimeout bounds the wait and what is held afterwards.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
