{
  "schema": "calcdb.question/1",
  "probe": "r-access-dialog/runtime-query-end",
  "bookRefs": [
    "R-ORACLE-1",
    "OR-DESKTOP",
    "OR-OWN",
    "R-UDF-1",
    "UDF-ERROR",
    "UDF-CONTEXT"
  ],
  "description": "Owned Access host, visible, main desktop; a new current database and a generated module; a CurrentDb snapshot of SELECT ID, CalcDbRaise(ID) FROM T read to the end, the dialog answered End at each failing row; then the host DBEngine.Errors. Asks what the field read returns once the dialog is ended, and whether the scan goes on. Every dialog of the host is described by UI Automation; the policy answers it.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
  "pathBinding": "attempt-local-copy",
  "inputs": [],
  "program": [
    {
      "op": "observeFiles",
      "label": "before-open",
      "keep": false
    },
    {
      "op": "observeModules",
      "label": "before-activate"
    },
    {
      "op": "activate",
      "class": "Access.Application",
      "route": "cocreate",
      "clsCtx": 4,
      "iid": "{00020400-0000-0000-C000-000000000046}",
      "bind": "app",
      "aggregate": false
    },
    {
      "op": "claimProcess",
      "target": "app",
      "member": "hWndAccessApp",
      "image": "MSACCESS.EXE"
    },
    {
      "op": "invoke",
      "target": "app",
      "member": "Version",
      "kind": "propertyGet",
      "args": []
    },
    {
      "op": "invoke",
      "target": "app",
      "member": "Build",
      "kind": "propertyGet",
      "args": []
    },
    {
      "op": "invoke",
      "target": "app",
      "member": "Visible",
      "kind": "propertyGet",
      "args": []
    },
    {
      "op": "invoke",
      "target": "app",
      "member": "UserControl",
      "kind": "propertyGet",
      "args": []
    },
    {
      "op": "invoke",
      "target": "app",
      "member": "AutomationSecurity",
      "kind": "propertyGet",
      "args": []
    },
    {
      "op": "invoke",
      "target": "app",
      "member": "AutomationSecurity",
      "kind": "propertyPut",
      "args": [
        {
          "type": "i4",
          "value": 1
        }
      ]
    },
    {
      "op": "invoke",
      "target": "app",
      "member": "AutomationSecurity",
      "kind": "propertyGet",
      "args": []
    },
    {
      "op": "invoke",
      "target": "app",
      "member": "Visible",
      "kind": "propertyPut",
      "args": [
        {
          "type": "bool",
          "value": true
        }
      ]
    },
    {
      "op": "invoke",
      "target": "app",
      "member": "Visible",
      "kind": "propertyGet",
      "args": []
    },
    {
      "op": "invoke",
      "target": "app",
      "member": "NewCurrentDatabase",
      "kind": "method",
      "args": [
        {
          "type": "outputPath",
          "fileName": "dialog-runtime-query-end.accdb"
        }
      ]
    },
    {
      "op": "invoke",
      "target": "app",
      "member": "CurrentDb",
      "kind": "method",
      "args": [],
      "bind": "db"
    },
    {
      "op": "invoke",
      "target": "db",
      "member": "Execute",
      "kind": "method",
      "args": [
        {
          "type": "bstr",
          "text": "CREATE TABLE T (ID LONG CONSTRAINT PK_T PRIMARY KEY, X DOUBLE, S TEXT(20), N LONG)"
        }
      ]
    },
    {
      "op": "invoke",
      "target": "db",
      "member": "Execute",
      "kind": "method",
      "args": [
        {
          "type": "bstr",
          "text": "INSERT INTO T VALUES (1, 1.5, 'a', Null)"
        }
      ]
    },
    {
      "op": "invoke",
      "target": "db",
      "member": "Execute",
      "kind": "method",
      "args": [
        {
          "type": "bstr",
          "text": "INSERT INTO T VALUES (2, 2.5, 'b', 7)"
        }
      ]
    },
    {
      "op": "invoke",
      "target": "db",
      "member": "Execute",
      "kind": "method",
      "args": [
        {
          "type": "bstr",
          "text": "INSERT INTO T VALUES (3, -0.5, Null, 3)"
        }
      ]
    },
    {
      "op": "writeFile",
      "file": "work:CalcDbGen.bas",
      "hex": ""
    },
    {
      "op": "invoke",
      "target": "app",
      "member": "LoadFromText",
      "kind": "method",
      "args": [
        {
          "type": "i4",
          "value": 5
        },
        {
          "type": "bstr",
          "text": "CalcDbGen"
        },
        {
          "type": "outputPath",
          "fileName": "CalcDbGen.bas"
        }
      ]
    },
    {
      "op": "invoke",
      "target": "db",
      "member": "OpenRecordset",
      "kind": "method",
      "args": [
        {
          "type": "bstr",
          "text": "SELECT ID, CalcDbRaise(ID) AS r FROM T ORDER BY ID"
        },
        {
          "type": "i4",
          "value": 4
        }
      ],
      "bind": "rs"
    },
    {
      "op": "loopUntil",
      "target": "rs",
      "member": "EOF",
      "maxIterations": 64,
      "body": [
        {
          "op": "invoke",
          "target": "rs",
          "member": "Fields",
          "kind": "propertyGet",
          "args": [],
          "bind": "flds"
        },
        {
          "op": "forEachItem",
          "target": "flds",
          "bind": "f",
          "maxItems": 32,
          "body": [
            {
              "op": "invoke",
              "target": "f",
              "member": "Value",
              "kind": "propertyGet",
              "args": []
            }
          ]
        },
        {
          "op": "release",
          "target": "flds"
        },
        {
          "op": "invoke",
          "target": "rs",
          "member": "MoveNext",
          "kind": "method",
          "args": []
        }
      ]
    },
    {
      "op": "invoke",
      "target": "rs",
      "member": "Close",
      "kind": "method",
      "args": []
    },
    {
      "op": "release",
      "target": "rs"
    },
    {
      "op": "invoke",
      "target": "app",
      "member": "DBEngine",
      "kind": "propertyGet",
      "args": [],
      "bind": "eng"
    },
    {
      "op": "invoke",
      "target": "eng",
      "member": "Errors",
      "kind": "propertyGet",
      "args": [],
      "bind": "errs"
    },
    {
      "op": "forEachItem",
      "target": "errs",
      "bind": "e",
      "maxItems": 16,
      "body": [
        {
          "op": "invoke",
          "target": "e",
          "member": "Number",
          "kind": "propertyGet",
          "args": []
        },
        {
          "op": "invoke",
          "target": "e",
          "member": "Description",
          "kind": "propertyGet",
          "args": []
        },
        {
          "op": "invoke",
          "target": "e",
          "member": "Source",
          "kind": "propertyGet",
          "args": []
        }
      ]
    },
    {
      "op": "release",
      "target": "errs"
    },
    {
      "op": "release",
      "target": "eng"
    },
    {
      "op": "invoke",
      "target": "db",
      "member": "Close",
      "kind": "method",
      "args": []
    },
    {
      "op": "release",
      "target": "db"
    },
    {
      "op": "invoke",
      "target": "app",
      "member": "CloseCurrentDatabase",
      "kind": "method",
      "args": []
    },
    {
      "op": "invoke",
      "target": "app",
      "member": "Quit",
      "kind": "method",
      "args": [
        {
          "type": "i4",
          "value": 2
        }
      ]
    },
    {
      "op": "release",
      "target": "app"
    },
    {
      "op": "pause",
      "ms": 3000
    },
    {
      "op": "observeFiles",
      "label": "after-close",
      "keep": false
    }
  ],
  "dialogPolicy": [
    {
      "title": "Microsoft Visual Basic",
      "press": "End",
      "text": "Run-time error"
    }
  ]
}
