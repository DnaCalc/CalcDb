{
  "schema": "calcdb.question/1",
  "probe": "r-cat-1/create-accdb-workspace-route",
  "bookRefs": [
    "R-CAT-1",
    "II-06",
    "CAT-NEW"
  ],
  "description": "R-CAT-1 creation: Workspaces(0).CreateDatabase(path, dbLangGeneral, dbVersion120), the Workspace route rather than DBEngine.CreateDatabase. Right after creation the returned Database's Version, CollatingOrder, Properties and TableDefs are read; the closed file is kept.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
  "pathBinding": "attempt-local-copy",
  "inputs": [],
  "program": [
    {
      "op": "observeModules",
      "label": "before-create"
    },
    {
      "op": "create",
      "progId": "DAO.DBEngine.120",
      "bind": "eng"
    },
    {
      "op": "observeModules",
      "label": "after-create"
    },
    {
      "op": "invoke",
      "target": "eng",
      "member": "Version",
      "kind": "propertyGet",
      "args": []
    },
    {
      "op": "invoke",
      "target": "eng",
      "member": "Workspaces",
      "kind": "propertyGet",
      "args": [],
      "bind": "wss"
    },
    {
      "op": "invoke",
      "target": "wss",
      "member": "Item",
      "kind": "methodOrGet",
      "args": [
        {
          "type": "i4",
          "value": 0
        }
      ],
      "bind": "ws"
    },
    {
      "op": "invoke",
      "target": "ws",
      "member": "CreateDatabase",
      "kind": "method",
      "args": [
        {
          "type": "outputPath",
          "fileName": "r-cat-1-accdb-workspace-route.accdb"
        },
        {
          "type": "bstr",
          "text": ";LANGID=0x0409;CP=1252;COUNTRY=0"
        },
        {
          "type": "i4",
          "value": 128
        }
      ],
      "bind": "db"
    },
    {
      "op": "invoke",
      "target": "db",
      "member": "Version",
      "kind": "propertyGet",
      "args": []
    },
    {
      "op": "invoke",
      "target": "db",
      "member": "CollatingOrder",
      "kind": "propertyGet",
      "args": []
    },
    {
      "op": "invoke",
      "target": "db",
      "member": "Properties",
      "kind": "propertyGet",
      "args": [],
      "bind": "cprops"
    },
    {
      "op": "forEachItem",
      "target": "cprops",
      "bind": "cp",
      "maxItems": 64,
      "body": [
        {
          "op": "invoke",
          "target": "cp",
          "member": "Name",
          "kind": "propertyGet",
          "args": []
        },
        {
          "op": "invoke",
          "target": "cp",
          "member": "Type",
          "kind": "propertyGet",
          "args": []
        },
        {
          "op": "invoke",
          "target": "cp",
          "member": "Value",
          "kind": "propertyGet",
          "args": []
        }
      ]
    },
    {
      "op": "release",
      "target": "cprops"
    },
    {
      "op": "invoke",
      "target": "db",
      "member": "TableDefs",
      "kind": "propertyGet",
      "args": [],
      "bind": "ctdfs"
    },
    {
      "op": "invoke",
      "target": "ctdfs",
      "member": "Count",
      "kind": "propertyGet",
      "args": []
    },
    {
      "op": "forEachItem",
      "target": "ctdfs",
      "bind": "ctd",
      "maxItems": 64,
      "body": [
        {
          "op": "invoke",
          "target": "ctd",
          "member": "Name",
          "kind": "propertyGet",
          "args": []
        },
        {
          "op": "invoke",
          "target": "ctd",
          "member": "Attributes",
          "kind": "propertyGet",
          "args": []
        }
      ]
    },
    {
      "op": "release",
      "target": "ctdfs"
    },
    {
      "op": "release",
      "target": "ws"
    },
    {
      "op": "release",
      "target": "wss"
    },
    {
      "op": "invoke",
      "target": "db",
      "member": "Close",
      "kind": "method",
      "args": []
    },
    {
      "op": "release",
      "target": "db"
    },
    {
      "op": "release",
      "target": "eng"
    },
    {
      "op": "observeModules",
      "label": "after-close"
    },
    {
      "op": "observeFiles",
      "label": "after-close",
      "keep": false
    }
  ]
}
