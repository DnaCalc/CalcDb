{
  "schema": "calcdb.question/1",
  "probe": "r-cat-1/create-accdb-in-transaction",
  "bookRefs": [
    "R-CAT-1",
    "II-06",
    "CAT-NEW"
  ],
  "description": "CAT-NEW transaction case: Workspaces(0).BeginTrans, then Workspace.CreateDatabase(path, dbLangGeneral, dbVersion120) and CREATE TABLE T in the new Database, then Workspace.Rollback. Asks for the TableDefs (after Refresh), Workspace.Databases.Count and file state before and after the Rollback.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
  "pathBinding": "attempt-local-copy",
  "inputs": [],
  "program": [
    {
      "op": "observeModules",
      "label": "before-create"
    },
    {
      "op": "create",
      "progId": "DAO.DBEngine.120",
      "bind": "eng"
    },
    {
      "op": "observeModules",
      "label": "after-create"
    },
    {
      "op": "invoke",
      "target": "eng",
      "member": "Workspaces",
      "kind": "propertyGet",
      "args": [],
      "bind": "wss"
    },
    {
      "op": "invoke",
      "target": "wss",
      "member": "Item",
      "kind": "methodOrGet",
      "args": [
        {
          "type": "i4",
          "value": 0
        }
      ],
      "bind": "ws"
    },
    {
      "op": "invoke",
      "target": "ws",
      "member": "BeginTrans",
      "kind": "method",
      "args": []
    },
    {
      "op": "invoke",
      "target": "ws",
      "member": "CreateDatabase",
      "kind": "method",
      "args": [
        {
          "type": "outputPath",
          "fileName": "r-cat-1-accdb-in-transaction.accdb"
        },
        {
          "type": "bstr",
          "text": ";LANGID=0x0409;CP=1252;COUNTRY=0"
        },
        {
          "type": "i4",
          "value": 128
        }
      ],
      "bind": "db"
    },
    {
      "op": "invoke",
      "target": "db",
      "member": "Execute",
      "kind": "method",
      "args": [
        {
          "type": "bstr",
          "text": "CREATE TABLE T (ID LONG)"
        }
      ]
    },
    {
      "op": "observeFiles",
      "label": "in-transaction",
      "keep": false
    },
    {
      "op": "invoke",
      "target": "ws",
      "member": "Rollback",
      "kind": "method",
      "args": []
    },
    {
      "op": "invoke",
      "target": "db",
      "member": "TableDefs",
      "kind": "propertyGet",
      "args": [],
      "bind": "tdfs"
    },
    {
      "op": "invoke",
      "target": "tdfs",
      "member": "Refresh",
      "kind": "method",
      "args": []
    },
    {
      "op": "invoke",
      "target": "tdfs",
      "member": "Count",
      "kind": "propertyGet",
      "args": []
    },
    {
      "op": "forEachItem",
      "target": "tdfs",
      "bind": "tdf",
      "maxItems": 64,
      "body": [
        {
          "op": "invoke",
          "target": "tdf",
          "member": "Name",
          "kind": "propertyGet",
          "args": []
        }
      ]
    },
    {
      "op": "release",
      "target": "tdfs"
    },
    {
      "op": "invoke",
      "target": "ws",
      "member": "Databases",
      "kind": "propertyGet",
      "args": [],
      "bind": "dbs"
    },
    {
      "op": "invoke",
      "target": "dbs",
      "member": "Count",
      "kind": "propertyGet",
      "args": []
    },
    {
      "op": "release",
      "target": "dbs"
    },
    {
      "op": "observeFiles",
      "label": "after-rollback",
      "keep": false
    },
    {
      "op": "invoke",
      "target": "db",
      "member": "Close",
      "kind": "method",
      "args": []
    },
    {
      "op": "release",
      "target": "db"
    },
    {
      "op": "release",
      "target": "ws"
    },
    {
      "op": "release",
      "target": "wss"
    },
    {
      "op": "release",
      "target": "eng"
    },
    {
      "op": "observeModules",
      "label": "after-close"
    },
    {
      "op": "observeFiles",
      "label": "after-close",
      "keep": false
    }
  ]
}
