{
  "schema": "calcdb.question/1",
  "probe": "r-cat-1b/qd-updatable-by-shape",
  "bookRefs": [
    "R-CAT-1",
    "II-06",
    "CAT-Q"
  ],
  "description": "On a writable copy of the base fixture, QueryDefs are created for these statements: SELECT ID, A FROM T; | SELECT T.ID, T.A, U.V FROM T INNER JOIN U ON T.ID = U.TID; | SELECT A, Count(*) AS N FROM T GROUP BY A; | SELECT DISTINCT A FROM T; | SELECT ID, A FROM T UNION SELECT ID, A FROM W; | SELECT ID, A, B * 2 AS X FROM T; | SELECT ID, A FROM T WHERE ID IN (SELECT TID FROM U); | SELECT TOP 2 ID, A FROM T ORDER BY ID; For each, QueryDef.Updatable is read, a dbOpenDynaset Recordset is opened from it (DBEngine.Errors) and that Recordset's Updatable is read.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
