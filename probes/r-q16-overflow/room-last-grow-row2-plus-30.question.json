{
  "schema": "calcdb.question/1",
  "probe": "r-q16-overflow/room-last-grow-row2-plus-30",
  "bookRefs": [
    "R-FMT-2",
    "Overflow / deletion",
    "Map ownership and growth",
    "II-03 concrete mutation probes",
    "W-05/growth-structural-closure"
  ],
  "description": "A copy of the r-fmt-2b-w-accdb fixture. First a session of its own runs DELETE FROM Pg WHERE ID IN (11, 12), leaving page 57 (the FreeMap's page) with room for the grown row; then the grow-row2-plus-30 UPDATE in a second session. Each session opens the database shared read/write through DAO, runs its statements with dbFailOnError (RecordsAffected read), and closes, with the DBEngine alive. Pg: 12 rows, ID and eight Text(255) fields T1..T8 of 61 U+20AC each; rows 1-4 fill page 55 with 58 bytes free. Page 122, Au4's old data page, is the only free page inside the 123-page file. After each session the file is read page by page (every page's hash; page 0 bytes 3584-3591 and pages 1, 52, 53, 54, 55, 56, 57, 106, 107, 108, 109, 110, 119, 120, 121, 122, 123, 124, 125 kept), and at the end Pg is read back read-only. Asks which page the grown row moves to and which bytes of the root, the target, the maps, page 1 and page 0 change.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
