{
  "schema": "calcdb.question/1",
  "probe": "r-access-host/launch-quit",
  "bookRefs": [
    "R-ORACLE-1",
    "OR-OWN",
    "R-UDF-1",
    "UDF-CONTEXT",
    "R-ACT-1"
  ],
  "description": "Owned Access host (Access.Application, local server, claimed by hWndAccessApp; AutomationSecurity low on this instance; generated fixture code only): activate, claim, read Version, Build, Visible, UserControl and AutomationSecurity before and after setting it, the host's DBEngine.Version, then Quit(acQuitSaveNone). Asks the host identity, its default visibility and control state, and whether it ends after Quit and Release.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
  "pathBinding": "attempt-local-copy",
  "inputs": [],
  "program": [
    {
      "op": "observeFiles",
      "label": "before-open",
      "keep": false
    },
    {
      "op": "observeModules",
      "label": "before-activate"
    },
    {
      "op": "activate",
      "class": "Access.Application",
      "route": "cocreate",
      "clsCtx": 4,
      "iid": "{00020400-0000-0000-C000-000000000046}",
      "bind": "app",
      "aggregate": false
    },
    {
      "op": "claimProcess",
      "target": "app",
      "member": "hWndAccessApp",
      "image": "MSACCESS.EXE"
    },
    {
      "op": "invoke",
      "target": "app",
      "member": "Version",
      "kind": "propertyGet",
      "args": []
    },
    {
      "op": "invoke",
      "target": "app",
      "member": "Build",
      "kind": "propertyGet",
      "args": []
    },
    {
      "op": "invoke",
      "target": "app",
      "member": "Visible",
      "kind": "propertyGet",
      "args": []
    },
    {
      "op": "invoke",
      "target": "app",
      "member": "UserControl",
      "kind": "propertyGet",
      "args": []
    },
    {
      "op": "invoke",
      "target": "app",
      "member": "AutomationSecurity",
      "kind": "propertyGet",
      "args": []
    },
    {
      "op": "invoke",
      "target": "app",
      "member": "AutomationSecurity",
      "kind": "propertyPut",
      "args": [
        {
          "type": "i4",
          "value": 1
        }
      ]
    },
    {
      "op": "invoke",
      "target": "app",
      "member": "AutomationSecurity",
      "kind": "propertyGet",
      "args": []
    },
    {
      "op": "invoke",
      "target": "app",
      "member": "DBEngine",
      "kind": "propertyGet",
      "args": [],
      "bind": "aeng"
    },
    {
      "op": "invoke",
      "target": "aeng",
      "member": "Version",
      "kind": "propertyGet",
      "args": []
    },
    {
      "op": "release",
      "target": "aeng"
    },
    {
      "op": "invoke",
      "target": "app",
      "member": "Quit",
      "kind": "method",
      "args": [
        {
          "type": "i4",
          "value": 2
        }
      ]
    },
    {
      "op": "release",
      "target": "app"
    },
    {
      "op": "pause",
      "ms": 3000
    },
    {
      "op": "observeModules",
      "label": "end"
    }
  ]
}
