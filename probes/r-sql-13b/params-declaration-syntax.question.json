{
  "schema": "calcdb.question/1",
  "probe": "r-sql-13b/params-declaration-syntax",
  "bookRefs": [
    "R-SQL-3",
    "SQL-B"
  ],
  "description": "Which PARAMETERS declaration spellings are accepted by CreateQueryDef, with which Parameters list (Name, Type, Direction, Value) and error number where refused: a missing semicolon, two declarations, a trailing comma, a missing type, an empty list, bracketed names (with a space, with an escaped bracket, a reserved word), a name equal to a column, a qualified name, a UNION body, the declaration after the SELECT, two names that differ only in case, a use in another case, a lower-case type, and names of 64 and 65 characters? Runs on a fresh copy of r-sql-13b-main (ACCDB) opened read-only through ACE DAO; each text goes into a temporary QueryDef (CreateQueryDef with an empty name, then DBEngine.Errors).",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
