{
  "schema": "calcdb.question/1",
  "probe": "r-lock-3-4-txn/write-timing-release-boundaries",
  "bookRefs": [
    "R-LOCK-4",
    "WRITE-TIMING",
    "R-LOCK-3",
    "READ-LIFE"
  ],
  "description": "Process a holds a dbPessimistic Edit on row 1 and passes through six states: (0) Edit pending; (1) CancelUpdate; (2) Edit, assign and Update; (3) Edit then Recordset.Close; (4) a new Edit, then the Recordset is released without Close; (5) a new Edit, then Database.Close with the recordset still open. After each state process b executes UPDATE T SET V = V + 1 WHERE ID = 1 (errors and RecordsAffected recorded) and reads row 1. Asks at which state b's write on the held row is admitted.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
