{
  "schema": "calcdb.question/1",
  "probe": "r-lock-3-4-txn/read-role-edit-existing-readers",
  "bookRefs": [
    "R-LOCK-3",
    "READ-ROLE",
    "READ-REFRESH"
  ],
  "description": "Process b opens a snapshot, dynaset, forward-only and table-type (index PK_T) cursor over rows 1, 2 and 64 and reads the first row of each. Process a then Edits row 1 through a dbPessimistic dynaset; b re-reads each held cursor (Move 0, read, Transactions) and also opens new cursors. Then a assigns N and Updates; b re-reads the held cursors, then Requery and reads, then new cursors. Existing readers and a later new reader are thereby separate observations of the same Edit/Update.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
