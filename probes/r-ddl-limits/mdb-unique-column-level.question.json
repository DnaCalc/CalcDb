      "op": "invoke",
      "target": "db",
      "member": "Execute",
      "kind": "method",
      "args": [
        {
          "type": "bstr",
          "text": "CREATE TABLE P2 (ID LONG CONSTRAINT PK_P2 PRIMARY KEY, PID LONG)"
