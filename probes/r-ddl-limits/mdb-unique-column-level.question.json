  "description": "On a new MDB database holding P(ID LONG primary key) and P2(ID LONG primary key, PID LONG), Database.Execute of: CREATE TABLE C (ID LONG CONSTRAINT PK_C PRIMARY KEY, Code TEXT(10) CONSTRAINT UX_C UNIQUE) — then the TableDefs and their fields are listed and DBEngine.Errors read.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
  "pathBinding": "attempt-local-copy",
  "inputs": [],
