      "kind": "method",
      "args": [
        {
          "type": "bstr",
          "text": "CREATE TABLE C (ID LONG CONSTRAINT PK_C PRIMARY KEY, Code TEXT(10) CONSTRAINT UX_C UNIQUE)"
        }
      ]
