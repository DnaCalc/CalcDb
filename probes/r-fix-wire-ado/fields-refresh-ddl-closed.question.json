{
  "schema": "calcdb.question/1",
  "probe": "r-fix-wire-ado/fields-refresh-ddl-closed",
  "bookRefs": [
    "R-ADO-1",
    "ADO-SCHEMA",
    "ADO-RESYNC",
    "R-CAT-1"
  ],
  "description": "Repairs r-ado-1b/fields-refresh-ddl: ALTER TABLE W failed because the probe's own recordsets held W, so no DDL was applied and the later Fields.Item(\"X\") answers carry no meaning. On a read-write copy of r-ado-1b-main, with each recordset closed before the DDL: each recordset of SELECT * FROM W ORDER BY ID reads Fields.Count, calls Fields.Refresh and reads Count; ALTER TABLE W ADD COLUMN X TEXT(10) executes on the Connection with Connection.Errors read and cleared right after; each retained Fields collection reads Count, is Refreshed (Errors after) and reads Count; each recordset is then reopened with the same arguments and reads State, the retained collection's Count, Refresh and Count, and Requery and Count; Fields.Item(\"X\") Name is read; a new recordset of the same SELECT reads Count and Fields.Item(\"X\"). Asks whether the ALTER succeeds, and whether Refresh, Requery, reopening or neither picks up the new column.",
  "callerSurface": "native-idispatch/x64",
  "invokeLcid": 1033,
  "observationRecipe": [
    "clearErrorInfoBefore",
    "excepinfo",
    "deferredFill",
    "errorInfo"
  ],
  "pathBinding": "attempt-local-copy",
