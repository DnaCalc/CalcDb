      "target": "db",
      "member": "Execute",
      "kind": "method",
      "args": [
        {
          "type": "bstr",
          "text": "INSERT INTO T (ID, S) VALUES (1, 'one')"
        }
      ]
    },
    {
      "op": "invoke",
      "target": "db",
