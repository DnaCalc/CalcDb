<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds the derived Access evidence index (.accdb) from retained JSON (The Plan §2.5).
       The index is rebuildable and never versioned. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>calcdb-evidence-index</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CalcDb.Evidence\CalcDb.Evidence.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ExcelDna.Interop.Dao" Version="16.0.0" />
  </ItemGroup>
</Project>
