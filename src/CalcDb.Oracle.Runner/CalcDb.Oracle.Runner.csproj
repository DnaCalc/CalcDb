<Project Sdk="Microsoft.NET.Sdk">
  <!-- Oracle runner CLI: submit-or-query, owned attempts, sealing, fixture freezing and retention.
       Platform-neutral except for launching the Windows worker. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>calcdb-oracle</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EmbedCalcDbSource>true</EmbedCalcDbSource>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CalcDb.Evidence\CalcDb.Evidence.csproj" />
    <ProjectReference Include="..\CalcDb.Corpus\CalcDb.Corpus.csproj" />
    <ProjectReference Include="..\CalcDb.Format\CalcDb.Format.csproj" />
    <ProjectReference Include="..\CalcDb.Catalog\CalcDb.Catalog.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CalcDb.Evidence.Tests" />
  </ItemGroup>
</Project>