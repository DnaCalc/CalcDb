<Project Sdk="Microsoft.NET.Sdk">
  <!-- W-08/factory-host-core (II-13 §§2-4, 15-17, 23): the native CalcDb module. Published with NativeAOT as a native
       DLL (CalcDb.dll) exporting DllGetClassObject, DllCanUnloadNow and the host bootstrap; interface heads and vtables
       are laid out by hand from the captured DAO and ADO declarations (W-09/construction-policy adds ADO). Publish: dotnet publish src/CalcDb.Com -r win-x64 -c Release -->
  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <AssemblyName>CalcDb</AssemblyName>
    <RootNamespace>CalcDb.Com</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CalcDb.Com.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Beside CalcDb.dll: a manifest's file element names a module in the manifest's own directory. -->
    <None Include="deploy\*.manifest" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CalcDb.Foundation\CalcDb.Foundation.csproj" />
    <ProjectReference Include="..\CalcDb.Values\CalcDb.Values.csproj" />
    <ProjectReference Include="..\CalcDb.Format\CalcDb.Format.csproj" />
    <ProjectReference Include="..\CalcDb.Storage\CalcDb.Storage.csproj" />
    <ProjectReference Include="..\CalcDb.Storage.Windows\CalcDb.Storage.Windows.csproj" />
    <ProjectReference Include="..\CalcDb.Isam\CalcDb.Isam.csproj" />
    <ProjectReference Include="..\CalcDb.Catalog\CalcDb.Catalog.csproj" />
    <ProjectReference Include="..\CalcDb.Expressions\CalcDb.Expressions.csproj" />
    <ProjectReference Include="..\CalcDb.Sql\CalcDb.Sql.csproj" />
  </ItemGroup>
  <!-- The deployment image's type libraries (II-13 §§11, 16; R-ACT-1 ACT-META, 77wt): the published module saves its
       own declarations as CalcDb.DAO.tlb and CalcDb.ADODB.tlb beside itself. Nothing is registered. -->
  <Target Name="SaveTypeLibraryImages" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <PropertyGroup>
      <_CalcDbModule>$([System.IO.Path]::GetFullPath('$(PublishDir)CalcDb.dll'))</_CalcDbModule>
      <_CalcDbImageDir>$([System.IO.Path]::GetDirectoryName('$(_CalcDbModule)'))</_CalcDbImageDir>
    </PropertyGroup>
    <Delete Files="$(_CalcDbImageDir)\CalcDb.DAO.tlb;$(_CalcDbImageDir)\CalcDb.ADODB.tlb" />
    <Exec Command="&quot;$(SystemRoot)\System32\rundll32.exe&quot; &quot;$(_CalcDbModule)&quot;,CalcDbSaveTypeLibraries" />
    <Error Condition="!Exists('$(_CalcDbImageDir)\CalcDb.DAO.tlb') Or !Exists('$(_CalcDbImageDir)\CalcDb.ADODB.tlb')" Text="$(_CalcDbModule) did not save its type libraries." />
  </Target>
</Project>