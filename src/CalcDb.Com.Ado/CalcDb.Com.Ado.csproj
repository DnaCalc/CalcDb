<Project Sdk="Microsoft.NET.Sdk">
  <!-- W-09 ADO COM object model and captured ADODB type library declarations (I-01, I-12, II-12, II-13).
       Separable from DAO: must not reference CalcDb.Com.Dao. -->
  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <RootNamespace>CalcDb.Com.Ado</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CalcDb" />
    <InternalsVisibleTo Include="CalcDb.Com.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CalcDb.Com.Core\CalcDb.Com.Core.csproj" />
  </ItemGroup>
</Project>
