<Project Sdk="Microsoft.NET.Sdk">
  <!-- The positioned native adapter for Windows (W-03/positioned-native, II-03 §2.4): overlapped positioned I/O with
       owned requests, admission by share mode, file identity, extent, flush and byte-range locks (K-IO, K-LOCK). -->
  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <RootNamespace>CalcDb.Storage.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CalcDb.Storage\CalcDb.Storage.csproj" />
  </ItemGroup>
</Project>
