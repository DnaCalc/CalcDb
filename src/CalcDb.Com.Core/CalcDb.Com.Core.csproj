<Project Sdk="Microsoft.NET.Sdk">
  <!-- W-08/W-09 shared COM infrastructure: interface heads, IDispatch/vtable dispatch, errors, type library images,
       declaration metadata types, host binding identity, and the shared native database/SQL session core used by both
       CalcDb.Com.Dao and CalcDb.Com.Ado. -->
  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <RootNamespace>CalcDb.Com</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CalcDb.Foundation\CalcDb.Foundation.csproj" />
    <ProjectReference Include="..\CalcDb.Values\CalcDb.Values.csproj" />
    <ProjectReference Include="..\CalcDb.Values.Windows\CalcDb.Values.Windows.csproj" />
    <ProjectReference Include="..\CalcDb.Format\CalcDb.Format.csproj" />
    <ProjectReference Include="..\CalcDb.Storage\CalcDb.Storage.csproj" />
    <ProjectReference Include="..\CalcDb.Storage.Windows\CalcDb.Storage.Windows.csproj" />
    <ProjectReference Include="..\CalcDb.Isam\CalcDb.Isam.csproj" />
    <ProjectReference Include="..\CalcDb.Catalog\CalcDb.Catalog.csproj" />
    <ProjectReference Include="..\CalcDb.Expressions\CalcDb.Expressions.csproj" />
    <ProjectReference Include="..\CalcDb.Sql\CalcDb.Sql.csproj" />
  </ItemGroup>
</Project>
