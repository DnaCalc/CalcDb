<Project Sdk="Microsoft.NET.Sdk">
  <!-- R-ORACLE-1 OR-DESKTOP: describes a dialog of an owned process by UI Automation and, by the question's dialog
       policy, invokes one of its buttons. Started by the runner on the dialog's own desktop. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>calcdb-dialogs</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CalcDb.Evidence\CalcDb.Evidence.csproj" />
  </ItemGroup>
</Project>
