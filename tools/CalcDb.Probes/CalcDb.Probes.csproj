<Project Sdk="Microsoft.NET.Sdk">
  <!-- Probe definitions in C#, generated into probes/<card>/*.question.json (W-01; A-02 cards). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>calcdb-probes</AssemblyName>
    <!-- Probe definitions are data: constant argument arrays (CA1861) are intended. -->
    <NoWarn>$(NoWarn);CA1861</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="CalcDb.Evidence" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\CalcDb.Evidence\CalcDb.Evidence.csproj" />
  </ItemGroup>
</Project>
